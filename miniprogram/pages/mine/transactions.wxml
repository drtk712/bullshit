<view class="list-page">
  <view class="list-hero points">
    <text class="hero-kicker">Points</text>
    <text class="hero-title">积分明细</text>
    <text class="hero-desc">签到、分享和生成消耗都在这里</text>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <view class="mini-spinner"></view>
    <text class="state-text">加载中</text>
  </view>

  <view wx:elif="{{error}}" class="state-card">
    <view class="state-icon">!</view>
    <text class="state-text error">{{error}}</text>
  </view>

  <block wx:else>
    <view class="record-list">
      <view wx:for="{{transactions}}" wx:key="_id" class="transaction-item">
        <view class="coin-thumb">分</view>
        <view class="transaction-main">
          <text class="transaction-title">{{item.typeText}}</text>
          <text class="transaction-time">{{item.timeText}}</text>
        </view>
        <text class="transaction-amount {{item.amountClass}}">{{item.amountText}}</text>
      </view>
    </view>

    <view wx:if="{{transactions.length === 0}}" class="empty-state">
      <text class="empty-title">暂无积分记录</text>
      <text class="empty-desc">生成、签到后会自动记录</text>
    </view>

    <view wx:if="{{loadingMore}}" class="load-more">
      <view class="mini-spinner"></view>
      <text class="load-more-text">加载中</text>
    </view>

    <view wx:if="{{!hasMore && transactions.length > 0}}" class="no-more">
      <text class="no-more-text">已展示全部明细</text>
    </view>
  </block>
</view>
