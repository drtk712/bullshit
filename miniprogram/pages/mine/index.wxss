page {
  background: #f7f7f7;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 120rpx;
  box-sizing: border-box;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid #eeeeee;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-spinner.small {
  width: 36rpx;
  height: 36rpx;
  border-width: 3rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.user-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.card-loading {
  display: flex;
  width: 100%;
  height: 120rpx;
  align-items: center;
  justify-content: center;
}

.card-error {
  display: flex;
  width: 100%;
  height: 120rpx;
  align-items: center;
  justify-content: center;
}

.card-error-text {
  color: #e64340;
  font-size: 26rpx;
}

.user-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #f0fbf5;
  font-size: 32rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  color: #111111;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.user-id {
  margin-top: 8rpx;
  color: #888888;
  font-size: 24rpx;
}

.user-hint {
  margin-bottom: 24rpx;
  padding-left: 4rpx;
  color: #999999;
  font-size: 24rpx;
}

.points-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.points-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.points-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.points-label {
  color: #888888;
  font-size: 28rpx;
}

.points-value {
  margin-top: 8rpx;
  color: #07c160;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.2;
}

.points-hint {
  margin-top: 8rpx;
  color: #999999;
  font-size: 24rpx;
}

.checkin-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 72rpx;
  background: #07c160;
  border-radius: 36rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.checkin-btn.checked {
  background: #e8e8e8;
  color: #999999;
}

.records-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.records-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.records-title {
  color: #111111;
  font-size: 34rpx;
  font-weight: 600;
}

.records-more {
  color: #07c160;
  font-size: 26rpx;
}

.section-loading {
  display: flex;
  height: 200rpx;
  align-items: center;
  justify-content: center;
}

.section-error {
  display: flex;
  height: 200rpx;
  align-items: center;
  justify-content: center;
}

.section-error-text {
  color: #e64340;
  font-size: 26rpx;
}

.transaction-item,
.task-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.transaction-main {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.transaction-title {
  color: #222222;
  font-size: 28rpx;
}

.transaction-time {
  margin-top: 8rpx;
  color: #bbbbbb;
  font-size: 23rpx;
}

.transaction-amount {
  margin-left: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.amount-plus {
  color: #07c160;
}

.amount-minus {
  color: #e64340;
}

.transaction-item:last-child,
.task-item:last-child {
  border-bottom: none;
}

.task-name {
  flex: 1;
  color: #222222;
  font-size: 28rpx;
}

.task-status {
  margin-right: 16rpx;
  font-size: 24rpx;
}

.status-pending {
  color: #ff9500;
}

.status-processing {
  color: #1677ff;
}

.status-completed {
  color: #07c160;
}

.status-failed {
  color: #e64340;
}

.status-refunded {
  color: #888888;
}

.task-time {
  color: #bbbbbb;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.empty-text {
  color: #999999;
  font-size: 26rpx;
}