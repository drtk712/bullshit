page {
  background:
    radial-gradient(circle at 85% 5%, rgba(255, 238, 196, 0.82), transparent 28%),
    radial-gradient(circle at 4% 0%, rgba(206, 255, 225, 0.86), transparent 30%),
    #fbfcf8;
}

.mine-page {
  min-height: 100vh;
  padding: 88rpx 24rpx 118rpx;
  color: #17211b;
}

.page-title,
.card-title,
.profile-name,
.profile-id,
.profile-tip,
.points-value,
.points-sub,
.test-sub,
.modal-title,
.modal-desc {
  display: block;
}

.page-title {
  margin-bottom: 18rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.profile-card,
.points-card,
.service-card,
.test-card {
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(58, 70, 62, 0.07);
}

.profile-card {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 18rpx;
}

.card-loading,
.card-error {
  width: 100%;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a938d;
  font-size: 24rpx;
}

.avatar {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 32% 24%, rgba(255, 255, 255, 0.92), transparent 18%),
    linear-gradient(135deg, #9cf5bf, #dfffee);
  color: #168653;
  text-align: center;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.name-row {
  display: flex;
  align-items: center;
}

.profile-name {
  color: #17211b;
  font-size: 28rpx;
  font-weight: 900;
}

.star {
  margin-left: 8rpx;
  color: #9aa29c;
  font-size: 23rpx;
}

.profile-id,
.profile-tip {
  margin-top: 5rpx;
  color: #8a938d;
  font-size: 21rpx;
}

.growth-badge {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  height: 42rpx;
  padding: 0 15rpx;
  border-radius: 999rpx;
  background: rgba(21, 199, 122, 0.12);
  color: #0f9f63;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.growth-mark {
  margin-right: 5rpx;
  font-size: 15rpx;
}

.points-card {
  margin-top: 14rpx;
  padding: 20rpx;
}

.points-head,
.points-row,
.test-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  color: #17211b;
  font-size: 25rpx;
  font-weight: 900;
}

.detail-link {
  color: #8a938d;
  font-size: 21rpx;
}

.points-row {
  margin-top: 12rpx;
}

.points-value {
  color: #15c77a;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.points-sub {
  margin-top: 10rpx;
  color: #8a938d;
  font-size: 20rpx;
}

.checkin-btn {
  min-width: 112rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #15c77a;
  color: #ffffff;
  text-align: center;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 48rpx;
  box-shadow: 0 8rpx 18rpx rgba(21, 199, 122, 0.24);
}

.checkin-btn.checked {
  background: #edf2ee;
  color: #9aa29c;
  box-shadow: none;
}

.service-card {
  margin-top: 16rpx;
  padding: 20rpx 16rpx 18rpx;
}

.service-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}

.service-item {
  flex: 1;
  min-width: 0;
  padding: 0;
  background: transparent;
  color: #555f58;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.2;
}

.service-item::after {
  border: none;
}

.share-service {
  display: block;
  border-radius: 0;
}

.service-icon {
  width: 46rpx;
  height: 46rpx;
  margin: 0 auto 9rpx;
  color: #68736c;
  font-size: 31rpx;
  line-height: 46rpx;
}

.test-card switch {
  transform: scale(0.82);
  transform-origin: right center;
}

.test-card {
  margin-top: 16rpx;
  padding: 20rpx;
}

.test-sub {
  margin-top: 8rpx;
  color: #8a938d;
  font-size: 21rpx;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.36);
}

.modal-card {
  position: relative;
  width: 100%;
  padding: 48rpx 34rpx 34rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 22rpx 60rpx rgba(39, 32, 24, 0.22);
  text-align: center;
}

.modal-close {
  position: absolute;
  right: 24rpx;
  top: 18rpx;
  color: #8b8580;
  font-size: 42rpx;
}

.gift-art {
  width: 118rpx;
  height: 118rpx;
  margin: 0 auto 18rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #ffd45d, #ff8b75);
  color: #ffffff;
  font-size: 70rpx;
  font-weight: 900;
  line-height: 118rpx;
}

.modal-title {
  color: #171615;
  font-size: 34rpx;
  font-weight: 900;
}

.modal-desc {
  margin-top: 12rpx;
  color: #8b8580;
  font-size: 25rpx;
}

.modal-btn {
  height: 84rpx;
  margin-top: 30rpx;
  border-radius: 999rpx;
  background: #15c77a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 84rpx;
}
