page {
  background: #f3fcf2;
}

.mine-page {
  min-height: 100vh;
  padding: 168rpx var(--ui-page-x) 220rpx;
  box-sizing: border-box;
  background: #f3fcf2;
  color: var(--ui-text);
}

.mine-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  height: 152rpx;
  padding: 76rpx var(--ui-page-x) 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  background: rgba(243, 252, 242, 0.86);
  backdrop-filter: blur(40rpx);
  box-shadow: var(--ui-shadow);
}

.mine-grid-icon,
.mine-nav-spacer {
  width: 64rpx;
  height: 64rpx;
}

.mine-grid-icon {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.mine-grid-icon view {
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid var(--ui-text-soft);
  border-radius: 2rpx;
  box-sizing: border-box;
}

.mine-nav-title {
  color: var(--ui-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 64rpx;
  letter-spacing: 0;
}

.profile-card,
.points-card,
.service-card,
.settings-card {
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
  box-sizing: border-box;
}

.profile-card {
  min-height: 144rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.card-loading,
.card-error {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-muted);
  font-size: 28rpx;
}

.avatar,
.avatar-img {
  flex: 0 0 144rpx;
  width: 144rpx;
  height: 144rpx;
  border: 4rpx solid rgba(21, 199, 122, 0.18);
  border-radius: 999rpx;
  background:
    radial-gradient(circle at 34% 26%, rgba(255, 255, 255, 0.9), transparent 20%),
    linear-gradient(135deg, #a8f7c8, #e7fff1);
  color: var(--ui-primary-dark);
  text-align: center;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 140rpx;
  box-sizing: border-box;
}

.avatar-img {
  display: block;
  background: var(--ui-surface);
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-name,
.profile-id,
.points-label,
.points-value,
.tomorrow-badge,
.service-title,
.service-sub,
.setting-title,
.setting-sub,
.modal-title,
.modal-desc {
  display: block;
}

.profile-name {
  overflow: hidden;
  max-width: 260rpx;
  color: var(--ui-text);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-badge {
  flex: 0 0 auto;
  height: 36rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--ui-primary);
  color: var(--ui-primary-dark);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.profile-id {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--ui-text-soft);
  font-size: 28rpx;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-edit {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  color: var(--ui-text-soft);
  text-align: center;
  font-size: 34rpx;
  line-height: 64rpx;
}

.points-card {
  position: relative;
  overflow: hidden;
  margin-top: 40rpx;
  padding: 40rpx;
}

.points-bg {
  position: absolute;
  right: -72rpx;
  top: -72rpx;
  width: 256rpx;
  height: 256rpx;
  border-radius: 999rpx;
  background: rgba(21, 199, 122, 0.1);
  filter: blur(20rpx);
}

.points-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.points-copy {
  flex: 1;
  min-width: 0;
}

.points-label {
  margin-bottom: 8rpx;
  color: var(--ui-text-soft);
  font-size: 28rpx;
  line-height: 40rpx;
}

.points-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.points-value {
  color: var(--ui-primary-dark);
  font-size: 80rpx;
  font-weight: 900;
  line-height: 88rpx;
}

.tomorrow-badge {
  margin-bottom: 10rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(246, 165, 18, 0.12);
  color: var(--ui-accent);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.points-detail-btn {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 64rpx;
  margin: 0 0 10rpx;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-surface-high);
  color: var(--ui-text-soft);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.points-detail-btn::after {
  border: 0;
}

.checkin-btn {
  flex: 0 0 auto;
  min-width: 176rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 36rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 88rpx;
  box-shadow: 0 10rpx 26rpx rgba(21, 199, 122, 0.18);
}

.checkin-btn::after {
  border: 0;
}

.checkin-btn.checked {
  background: var(--ui-surface);
  color: var(--ui-muted);
  box-shadow: none;
}

.earn-section {
  margin-top: 40rpx;
}

.earn-name,
.earn-reward,
.modal-points {
  display: block;
}

.earn-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.earn-item {
  min-height: 112rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-radius: 24rpx;
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
  box-sizing: border-box;
}

.earn-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.earn-icon {
  flex: 0 0 auto;
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 80rpx;
}

.earn-icon.checkin {
  background: var(--ui-surface);
  color: var(--ui-primary-dark);
}

.earn-icon.share {
  background: rgba(246, 165, 18, 0.16);
  color: var(--ui-accent);
}

.earn-name {
  color: var(--ui-text);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.earn-reward {
  margin-top: 4rpx;
  color: var(--ui-text-soft);
  font-size: 24rpx;
  line-height: 34rpx;
}

.earn-btn {
  flex: 0 0 50%;
  width: 50%;
  min-width: 0;
  height: 64rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-primary);
  color: var(--ui-primary-dark);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.earn-btn.secondary,
.earn-btn.done {
  background: var(--ui-surface-high);
  color: var(--ui-text-soft);
}

.earn-btn::after {
  border: 0;
}

.service-grid {
  margin-top: 40rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28rpx;
}

.service-card {
  width: 100%;
  min-height: 176rpx;
  margin: 0;
  padding: 28rpx;
  border: 0;
  line-height: normal;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
}

.service-card::after {
  border: 0;
}

.service-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.service-icon.history {
  background: rgba(21, 199, 122, 0.1);
  color: var(--ui-primary-dark);
}

.service-icon.favorite {
  background: rgba(246, 165, 18, 0.12);
  color: var(--ui-accent);
}

.service-icon.share {
  background: rgba(255, 143, 129, 0.14);
  color: var(--ui-error);
}

.service-icon.settings {
  background: var(--ui-surface);
  color: var(--ui-text-soft);
}

.service-title {
  color: var(--ui-text);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.service-sub {
  margin-top: 8rpx;
  color: var(--ui-text-soft);
  font-size: 24rpx;
  line-height: 34rpx;
}

.settings-card {
  margin-top: 40rpx;
  padding: 12rpx 32rpx;
}

.setting-row {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.setting-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.setting-icon {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--ui-surface);
  color: var(--ui-text-soft);
  text-align: center;
  font-size: 34rpx;
  line-height: 64rpx;
}

.setting-title {
  color: var(--ui-text);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.setting-sub {
  margin-top: 4rpx;
  color: var(--ui-text-soft);
  font-size: 24rpx;
  line-height: 34rpx;
}

.setting-row switch {
  flex: 0 0 auto;
  transform: scale(0.86);
  transform-origin: right center;
}

.setting-divider {
  height: 1rpx;
  margin-left: 88rpx;
  background: var(--ui-line);
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.36);
}

.modal-card {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  overflow: hidden;
  padding: 0;
  border-radius: var(--ui-radius-lg);
  background: #ffffff;
  box-shadow: var(--ui-shadow-strong);
  text-align: center;
}

.modal-close {
  position: absolute;
  right: 24rpx;
  top: 18rpx;
  color: #8b8580;
  font-size: 42rpx;
}

.reward-visual {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 44%, rgba(246, 165, 18, 0.2), transparent 34%),
    var(--ui-surface);
}

.gift-art {
  width: 140rpx;
  height: 140rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #ffd45d, #ff8b75);
  color: #ffffff;
  font-size: 78rpx;
  font-weight: 900;
  line-height: 140rpx;
}

.modal-title {
  margin-top: 32rpx;
  color: var(--ui-text);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 60rpx;
}

.modal-points {
  margin-top: 12rpx;
  color: var(--ui-accent);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.modal-desc {
  margin-top: 12rpx;
  padding: 0 40rpx;
  color: var(--ui-text-soft);
  font-size: 26rpx;
  line-height: 38rpx;
}

.modal-btn {
  width: calc(100% - 68rpx);
  height: 84rpx;
  margin: 32rpx 34rpx 34rpx;
  padding: 0;
  border-radius: 999rpx;
  background: var(--ui-primary);
  color: var(--ui-primary-dark);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.modal-btn::after {
  border: 0;
}

.profile-modal-card {
  padding-top: 42rpx;
}

.profile-avatar-button {
  width: 164rpx;
  height: 164rpx;
  margin: 34rpx auto 28rpx;
  padding: 0;
  overflow: hidden;
  border: 4rpx solid rgba(21, 199, 122, 0.18);
  border-radius: 999rpx;
  background: var(--ui-surface);
}

.profile-avatar-button::after {
  border: 0;
}

.profile-avatar-preview {
  width: 100%;
  height: 100%;
}

.profile-avatar-placeholder {
  color: var(--ui-primary-dark);
  font-size: 72rpx;
  font-weight: 700;
  line-height: 156rpx;
}

.profile-nickname-input {
  width: calc(100% - 68rpx);
  height: 88rpx;
  margin: 0 34rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: var(--ui-surface);
  color: var(--ui-text);
  font-size: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.profile-error {
  display: block;
  margin-top: 18rpx;
  color: var(--ui-error);
  font-size: 24rpx;
  line-height: 34rpx;
}
