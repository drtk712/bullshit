page {
  background: #fbfcf8;
}

.detail-page {
  min-height: 100vh;
  padding: 92rpx 20rpx 60rpx;
}

.detail-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  height: 82rpx;
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx 0;
  background: rgba(251, 252, 248, 0.86);
  backdrop-filter: blur(18rpx);
}

.back-btn {
  width: 52rpx;
  height: 52rpx;
  color: #17211b;
  font-size: 44rpx;
  line-height: 52rpx;
}

.nav-title {
  position: absolute;
  left: 120rpx;
  right: 120rpx;
  bottom: 12rpx;
  color: #17211b;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
}

.state-card,
.info-card,
.result-card,
.failed-card {
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 30rpx rgba(58, 70, 62, 0.08);
}

.state-card {
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-card .mini-spinner {
  margin-bottom: 18rpx;
}

.state-text {
  color: #8b948d;
  font-size: 25rpx;
}

.state-text.error {
  color: #d85043;
}

.state-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 109, 90, 0.14);
  color: #ff6d5a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.info-card {
  padding: 20rpx 22rpx 0;
}

.task-head {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  padding-bottom: 16rpx;
}

.task-cover {
  width: 66rpx;
  height: 66rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #ffe4d0, #dff8ee);
  color: #15c77a;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 66rpx;
}

.task-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.task-title,
.task-time,
.info-label,
.info-value,
.section-title,
.failed-reason,
.refund-title,
.refund-desc {
  display: block;
}

.task-title {
  color: #17211b;
  font-size: 27rpx;
  font-weight: 900;
}

.task-time {
  margin-top: 7rpx;
  color: #9ba49e;
  font-size: 21rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 66rpx;
  border-top: 1rpx solid rgba(23, 22, 21, 0.06);
}

.info-label {
  color: #8b948d;
  font-size: 24rpx;
}

.info-value {
  color: #17211b;
  font-size: 24rpx;
  font-weight: 900;
}

.info-value.plus,
.status-completed {
  color: #15c77a;
}

.status-failed,
.status-refunded {
  color: #f05d63;
}

.result-card,
.failed-card {
  margin-top: 16rpx;
  padding: 22rpx;
}

.section-title {
  color: #17211b;
  font-size: 26rpx;
  font-weight: 900;
}

.result-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.poster-thumb {
  width: 116rpx;
  height: 142rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #fff1df;
}

.poster-image {
  width: 100%;
  height: 100%;
}

.poster-placeholder-text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #8b948d;
  font-size: 21rpx;
}

.ghost-btn {
  flex: 1;
  height: 56rpx;
  margin-left: 16rpx;
  border-radius: 999rpx;
  background: #f7fffb;
  color: #15a86b;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 56rpx;
  border: 1rpx solid rgba(21, 199, 122, 0.22);
}

.failed-card {
  background: rgba(255, 255, 255, 0.94);
}

.failed-reason {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff1f1, #fff8f8);
  color: #805b5b;
  font-size: 23rpx;
  line-height: 1.48;
}

.refund-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fff8e7, #f0fff8);
}

.refund-title {
  color: #80601d;
  font-size: 24rpx;
  font-weight: 900;
}

.refund-desc {
  margin-top: 5rpx;
  color: #9ba49e;
  font-size: 21rpx;
}

.refund-points {
  color: #15c77a;
  font-size: 27rpx;
  font-weight: 900;
}

.retry-btn {
  height: 76rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #15c77a;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.delete-btn {
  height: 70rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #7e8781;
  font-size: 24rpx;
  line-height: 70rpx;
}

.progress-card {
  margin-top: 16rpx;
  padding: 60rpx 32rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  text-align: center;
}

.progress-orbit {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  border: 4rpx solid rgba(21, 199, 122, 0.22);
}

.progress-core {
  width: 86rpx;
  height: 86rpx;
  margin: 13rpx auto 0;
  border-radius: 999rpx;
  background: #eefaf4;
  color: #15c77a;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 86rpx;
}

.progress-title {
  display: block;
  margin-top: 26rpx;
  color: #17211b;
  font-size: 30rpx;
  font-weight: 900;
}

.progress-desc,
.sync-error {
  display: block;
  margin-top: 12rpx;
  color: #8b948d;
  font-size: 24rpx;
}
