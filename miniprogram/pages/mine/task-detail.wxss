page {
  background: #f7f7f7;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.state-card {
  display: flex;
  min-height: 220rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 48rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 16rpx;
  border: 4rpx solid #eeeeee;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.state-text {
  color: #888888;
  font-size: 27rpx;
}

.state-text.error {
  color: #e64340;
}

.info-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #888888;
  font-size: 28rpx;
}

.info-value {
  color: #222222;
  font-size: 28rpx;
  font-weight: 500;
}

.status-pending {
  color: #ff9500;
}

.status-processing {
  color: #1677ff;
}

.status-completed {
  color: #07c160;
}

.status-failed {
  color: #e64340;
}

.status-refunded {
  color: #888888;
}

.pending-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 64rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.pending-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.pending-title {
  display: block;
  color: #222222;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.pending-desc {
  display: block;
  color: #888888;
  font-size: 26rpx;
  margin-bottom: 32rpx;
}

.sync-error {
  display: block;
  color: #ff9500;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.pending-spinner {
  display: flex;
  justify-content: center;
}

.poster-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.poster-title {
  display: block;
  color: #111111;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.poster-container {
  background: #f9f9f9;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.poster-image {
  width: 100%;
  display: block;
}

.poster-placeholder {
  display: flex;
  min-height: 420rpx;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.poster-placeholder-text {
  color: #999999;
  font-size: 26rpx;
}

.poster-tip {
  display: block;
  text-align: center;
  color: #999999;
  font-size: 24rpx;
  padding: 16rpx 0;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.save-btn::after {
  border: none;
}

.failed-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 64rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.failed-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.failed-title {
  display: block;
  color: #e64340;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.failed-reason {
  display: block;
  color: #888888;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.refund-hint {
  display: inline-flex;
  align-items: center;
  background: #f0fdf4;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
}

.refund-text {
  color: #07c160;
  font-size: 26rpx;
}