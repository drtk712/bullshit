page {
  background: #f3fcf2;
}

.detail-page {
  min-height: 100vh;
  padding: 176rpx var(--ui-page-x) 80rpx;
  box-sizing: border-box;
  background: #f3fcf2;
  color: var(--ui-text);
}

.detail-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  height: 152rpx;
  padding: 76rpx var(--ui-page-x) 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  background: rgba(243, 252, 242, 0.86);
  backdrop-filter: blur(40rpx);
  box-shadow: var(--ui-shadow);
}

.back-btn,
.nav-spacer {
  width: 64rpx;
  height: 64rpx;
}

.back-btn {
  color: var(--ui-primary-dark);
  text-align: center;
  font-size: 58rpx;
  line-height: 58rpx;
}

.nav-title {
  color: var(--ui-text);
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.state-card,
.task-card {
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
  box-sizing: border-box;
}

.state-card {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-card .mini-spinner {
  margin-bottom: 18rpx;
}

.state-text {
  color: var(--ui-muted);
  font-size: 28rpx;
}

.state-text.error {
  color: var(--ui-error);
}

.state-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: var(--ui-error-soft);
  color: var(--ui-error);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.task-card {
  padding: 32rpx;
}

.task-card.failed {
  border: 1rpx solid rgba(216, 80, 67, 0.12);
}

.task-card-head {
  padding-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid var(--ui-line);
}

.task-status-left {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.status-icon {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(21, 199, 122, 0.12);
  color: var(--ui-primary);
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.status-icon.status-failed,
.status-icon.status-refunded {
  background: var(--ui-error-soft);
  color: var(--ui-error);
}

.task-state-title,
.task-time,
.error-title,
.error-desc,
.progress-title,
.progress-desc,
.sync-error {
  display: block;
}

.task-state-title {
  color: var(--ui-text);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 50rpx;
}

.task-time {
  margin-top: 4rpx;
  color: var(--ui-text-soft);
  font-size: 24rpx;
  line-height: 34rpx;
}

.cost-pill {
  flex: 0 0 auto;
  min-height: 44rpx;
  padding: 8rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-radius: 999rpx;
  background: rgba(246, 165, 18, 0.1);
  color: var(--ui-accent);
  font-size: 22rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.cost-star {
  font-size: 22rpx;
}

.task-preview {
  position: relative;
  overflow: hidden;
  height: 420rpx;
  margin-top: 32rpx;
  border-radius: 24rpx;
  background: var(--ui-surface);
}

.task-preview-image {
  width: 100%;
  height: 100%;
  display: block;
}

.poster-placeholder-text {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-text-soft);
  font-size: 26rpx;
}

.preview-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.1);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  opacity: 0;
}

.task-preview:active .preview-mask {
  opacity: 1;
}

.task-actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.task-action,
.retry-btn,
.delete-btn {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.task-action::after,
.retry-btn::after,
.delete-btn::after {
  border: 0;
}

.task-action {
  height: 80rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

.task-action.ghost {
  background: var(--ui-surface-high);
  color: var(--ui-text-soft);
}

.task-action.primary,
.retry-btn {
  background: var(--ui-primary);
  color: #fff;
  box-shadow: 0 10rpx 26rpx rgba(21, 199, 122, 0.18);
}

.error-panel {
  margin-top: 32rpx;
  padding: 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 218, 214, 0.35);
}

.error-icon {
  flex: 0 0 auto;
  color: var(--ui-error);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.error-title {
  color: var(--ui-text);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.error-desc {
  margin-top: 8rpx;
  color: var(--ui-text-soft);
  font-size: 24rpx;
  line-height: 36rpx;
}

.retry-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  font-size: 28rpx;
  line-height: 88rpx;
}

.progress-panel {
  margin-top: 32rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: var(--ui-surface);
  text-align: center;
}

.progress-orbit {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  border: 4rpx solid rgba(21, 199, 122, 0.22);
}

.progress-core {
  width: 92rpx;
  height: 92rpx;
  margin: 14rpx auto 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--ui-primary);
  font-size: 40rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.progress-title {
  margin-top: 26rpx;
  color: var(--ui-text);
  font-size: 32rpx;
  font-weight: 800;
}

.progress-desc,
.sync-error {
  margin-top: 12rpx;
  color: var(--ui-text-soft);
  font-size: 24rpx;
  line-height: 36rpx;
}

.sync-error {
  color: var(--ui-accent);
}

.delete-btn {
  width: 100%;
  height: 76rpx;
  margin-top: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--ui-muted);
  font-size: 24rpx;
  line-height: 76rpx;
}
