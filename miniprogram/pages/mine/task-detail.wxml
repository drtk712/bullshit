<view class="detail-page">
  <view class="detail-nav">
    <view class="back-btn" bindtap="goBack">‹</view>
    <text class="nav-title">任务详情</text>
    <view class="nav-spacer"></view>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <view class="mini-spinner"></view>
    <text class="state-text">加载中</text>
  </view>

  <view wx:elif="{{error}}" class="state-card">
    <view class="state-icon">!</view>
    <text class="state-text error">{{error}}</text>
  </view>

  <block wx:else>
    <view class="task-card {{task.status === 'failed' ? 'failed' : ''}}">
      <view class="task-card-head">
        <view class="task-status-left">
          <view class="status-icon {{task.statusClass}}">{{task.status === 'failed' ? '!' : task.status === 'completed' ? '✓' : '◴'}}</view>
          <view>
            <text class="task-state-title">{{task.status === 'failed' ? '生成失败' : task.status === 'completed' ? '生成完成' : task.statusText}}</text>
            <text class="task-time">{{task.formattedTime}}</text>
          </view>
        </view>
        <view class="cost-pill">
          <text class="cost-star">✦</text>
          <text>{{task.pointsCostText}}</text>
        </view>
      </view>

      <view wx:if="{{task.status === 'completed'}}" class="image-tabs">
        <text class="image-tab {{activeTab === 'result' ? 'active' : ''}}" data-tab="result" bindtap="switchTab">结果</text>
        <text class="image-tab {{activeTab === 'original' ? 'active' : ''}}" data-tab="original" bindtap="switchTab">原图</text>
      </view>

      <view wx:if="{{task.status === 'completed'}}" class="task-preview" bindtap="viewPoster">
        <block wx:if="{{activeTab === 'result'}}">
          <image wx:if="{{posterPreviewUrl}}" class="task-preview-image" src="{{posterPreviewUrl}}" mode="aspectFill"></image>
          <view wx:else class="poster-placeholder-text">{{posterError || '图片加载中'}}</view>
        </block>
        <block wx:elif="{{activeTab === 'original'}}">
          <image wx:if="{{originalImageUrl}}" class="task-preview-image" src="{{originalImageUrl}}" mode="aspectFill"></image>
          <view wx:else class="poster-placeholder-text">{{originalImageError || '原图加载中'}}</view>
        </block>
        <view class="preview-mask">
          <text>查看{{activeTab === 'original' ? '原图' : '大图'}}</text>
        </view>
      </view>

      <view wx:if="{{task.status === 'completed' && activeTab === 'result' && resultUrls.length > 0}}" class="result-pieces">
        <view class="pieces-heading">
          <text class="pieces-title">切分结果</text>
          <text class="pieces-count">{{resultUrls.length}} 张</text>
        </view>
        <view class="pieces-grid">
          <view class="piece-card" wx:for="{{resultUrls}}" wx:key="*this">
            <image class="piece-image" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="viewResultPiece"></image>
            <view class="piece-save" data-index="{{index}}" bindtap="saveResultPiece">保存</view>
          </view>
        </view>
      </view>

      <view wx:if="{{task.status === 'completed'}}" class="task-actions">
        <button class="task-action primary" bindtap="savePoster">
          <text class="action-icon">↓</text>
          <text>保存相册</text>
        </button>
        <button class="task-action ghost" open-type="share">
          <text class="action-icon">↗</text>
          <text>{{shareRewardCopy.buttonText}}</text>
        </button>
      </view>

      <view wx:elif="{{task.status === 'failed'}}" class="error-panel">
        <text class="error-icon">!</text>
        <view>
          <text class="error-title">抱歉，处理您的图片时遇到问题。</text>
          <text class="error-desc">{{task.friendlyErrMsg}}</text>
        </view>
      </view>

      <button wx:if="{{task.status === 'failed'}}" class="retry-btn" bindtap="retryUpload">▣ 重新上传</button>

      <view wx:if="{{task.status === 'init' || task.status === 'pending' || task.status === 'processing'}}" class="progress-panel">
        <view class="progress-orbit">
          <view class="progress-core">{{task.status === 'processing' ? '画' : '等'}}</view>
        </view>
        <text class="progress-title">{{task.status === 'processing' ? '正在生成图片' : task.status === 'init' ? '正在提交任务' : '任务排队中'}}</text>
        <text class="progress-desc">{{task.status === 'processing' ? '服务端正在处理，请稍候' : task.status === 'init' ? '任务已创建，正在交给服务端处理' : '任务已接收，正在等待开始处理'}}</text>
        <text wx:if="{{syncError}}" class="sync-error">{{syncError}}</text>
      </view>
    </view>

    <button class="delete-btn" bindtap="handleDeleteTask">删除记录</button>
  </block>
</view>
