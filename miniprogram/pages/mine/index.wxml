<view class="mine-page">
  <text class="page-title">我的</text>

  <view class="profile-card">
    <block wx:if="{{userLoading}}">
      <view class="card-loading"><view class="mini-spinner"></view></view>
    </block>
    <block wx:elif="{{userError}}">
      <view class="card-error">{{userError}}</view>
    </block>
    <block wx:else>
      <view class="avatar">◡</view>
      <view class="profile-main">
        <view class="name-row">
          <text class="profile-name">玩图达人</text>
          <text class="star">☆</text>
        </view>
        <text class="profile-id">ID: {{user.openidMasked || '未登录'}}</text>
        <text class="profile-tip" bindtap="onEditProfile">编辑资料 ›</text>
      </view>
      <view class="growth-badge"><text class="growth-mark">◆</text> 成长值 88</view>
    </block>
  </view>

  <view class="points-card">
    <view class="points-head">
      <text class="card-title">我的积分</text>
      <text class="detail-link" bindtap="goToTransactions">积分明细 ›</text>
    </view>
    <view class="points-row">
      <view>
        <text class="points-value">{{user.points || 0}}</text>
        <text class="points-sub">连续签到 3 天，明日可得 +1 积分</text>
      </view>
      <view class="checkin-btn {{checkedIn ? 'checked' : ''}}" bindtap="handleCheckIn">
        {{checkedIn ? '已签到' : '每日签到'}}
      </view>
    </view>
  </view>

  <view class="service-card">
    <text class="card-title">我的服务</text>
    <view class="service-grid">
      <view class="service-item" bindtap="goToTasks">
        <view class="service-icon">▤</view>
        <text>生成记录</text>
      </view>
      <view class="service-item" bindtap="onEditProfile">
        <view class="service-icon">☆</view>
        <text>意见反馈</text>
      </view>
      <button class="service-item share-service" open-type="share">
        <view class="service-icon">♢</view>
        <text>分享赚积分</text>
      </button>
      <view class="service-item" bindtap="onSettings">
        <view class="service-icon">⚙</view>
        <text>设置中心</text>
      </view>
    </view>
  </view>

  <view class="test-card">
    <view>
      <text class="card-title">试玩模式</text>
      <text class="test-sub">开启后返回测试图片，不调用付费 API</text>
    </view>
    <switch checked="{{testMode}}" bindchange="onTestModeChange" color="#15c77a" />
  </view>

  <view class="test-card">
    <view>
      <text class="card-title">不扣积分</text>
      <text class="test-sub">开启后真实生成但不消耗积分（仅开发版适用）</text>
    </view>
    <switch checked="{{skipPointsDeduction}}" bindchange="onSkipPointsChange" color="#15c77a" />
  </view>

  <view wx:if="{{showCheckInModal}}" class="modal-mask">
    <view class="modal-card">
      <view class="modal-close" bindtap="hideCheckInModal">×</view>
      <view class="gift-art">✓</view>
      <text class="modal-title">签到成功</text>
      <text class="modal-desc">+1 积分{{user.checkInDays ? '，已连续签到 ' + user.checkInDays + ' 天' : ''}}</text>
      <button class="modal-btn" bindtap="hideCheckInModal">开心收下</button>
    </view>
  </view>
</view>
