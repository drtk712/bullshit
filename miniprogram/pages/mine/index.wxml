<view class="mine-page ui-page">
  <app-nav title="我的" show-back="{{false}}" variant="tab"></app-nav>

  <view class="profile-card">
    <block wx:if="{{userLoading}}">
      <view class="card-loading"><view class="mini-spinner"></view></view>
    </block>
    <block wx:elif="{{userError}}">
      <view class="card-error">{{userError}}</view>
    </block>
    <block wx:else>
      <image wx:if="{{user.avatarFileID}}" class="avatar-img" src="{{user.avatarFileID}}" mode="aspectFill" />
      <view wx:else class="avatar">◡</view>
      <view class="profile-main">
        <view class="profile-name-row">
          <text class="profile-name">{{user.nickName || '玩图达人'}}</text>
          <text class="level-badge">LV.88</text>
        </view>
        <text class="profile-id">ID: {{user.openidMasked || '未登录'}}</text>
      </view>
      <view class="profile-edit" bindtap="onEditProfile">✎</view>
    </block>
  </view>

  <view class="points-card">
    <view class="points-bg"></view>
    <view class="points-content">
      <view class="points-copy">
        <text class="points-label">我的积分</text>
        <view class="points-row">
          <text class="points-value">{{user.points || 0}}</text>
          <text class="tomorrow-badge">明日可得 +1</text>
        </view>
      </view>
      <button class="points-detail-btn" bindtap="goToTransactions">明细</button>
    </view>
  </view>

  <view class="earn-section">
    <view class="earn-list">
      <view class="earn-item">
        <view class="earn-left">
          <view class="earn-icon checkin">▣</view>
          <view>
            <text class="earn-name">每日签到</text>
            <text class="earn-reward">+1 积分</text>
          </view>
        </view>
        <button class="earn-btn {{checkedIn ? 'done' : ''}}" loading="{{checkInLoading}}" bindtap="handleCheckIn">
          {{checkedIn ? '已完成' : '签到'}}
        </button>
      </view>
      <view class="earn-item">
        <view class="earn-left">
          <view class="earn-icon share">↗</view>
          <view>
            <text class="earn-name">{{shareRewardCopy.title}}</text>
            <text class="earn-reward">{{shareRewardCopy.rewardText}}</text>
          </view>
        </view>
        <button class="earn-btn secondary" open-type="share">{{shareRewardCopy.shortButtonText}}</button>
      </view>
    </view>
  </view>

  <view class="service-grid">
    <view class="service-card" bindtap="goToTasks">
      <view class="service-icon history">↺</view>
      <text class="service-title">处理记录</text>
      <text class="service-sub">查看历史图片</text>
    </view>
    <button class="service-card share-service" open-type="share">
      <view class="service-icon share">↗</view>
      <text class="service-title">{{shareRewardCopy.title}}</text>
      <text class="service-sub">{{shareRewardCopy.desc}}</text>
    </button>
  </view>

  <view wx:if="{{showCheckInModal}}" class="modal-mask">
    <view class="modal-card">
      <view class="modal-close" bindtap="hideCheckInModal">×</view>
      <view class="reward-visual">
        <view class="gift-art">✦</view>
      </view>
      <text class="modal-title">签到成功</text>
      <text class="modal-points">+1 积分</text>
      <text class="modal-desc">{{user.checkInDays ? '已连续签到 ' + user.checkInDays + ' 天' : '每日签到奖励已到账'}}</text>
      <button class="modal-btn" bindtap="hideCheckInModal">开心收下</button>
    </view>
  </view>

  <view wx:if="{{showProfileGate}}" class="modal-mask">
    <view class="modal-card profile-modal-card">
      <view class="modal-close" bindtap="hideProfileGate">×</view>
      <text class="modal-title">编辑头像昵称</text>
      <text class="modal-desc">头像和昵称会展示在个人资料与管理后台中。</text>

      <button class="profile-avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{profileAvatarTempPath}}" class="profile-avatar-preview" src="{{profileAvatarTempPath}}" mode="aspectFill" />
        <text wx:else class="profile-avatar-placeholder">+</text>
      </button>

      <input
        class="profile-nickname-input"
        type="nickname"
        value="{{profileNickName}}"
        placeholder="填写昵称"
        maxlength="24"
        bindinput="onNickNameInput"
      />

      <text wx:if="{{profileError}}" class="profile-error">{{profileError}}</text>
      <button class="modal-btn" loading="{{profileSaving}}" bindtap="onSaveProfile">保存资料</button>
    </view>
  </view>
</view>
