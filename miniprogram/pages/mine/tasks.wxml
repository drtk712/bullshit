<view class="records-page">
  <view class="records-nav">
    <text class="records-title">生成记录</text>
  </view>

  <view class="filter-row">
    <text class="filter {{activeFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onFilterTap">全部</text>
    <text class="filter {{activeFilter === 'processing' ? 'active' : ''}}" data-filter="processing" bindtap="onFilterTap">进行中</text>
    <text class="filter {{activeFilter === 'completed' ? 'active' : ''}}" data-filter="completed" bindtap="onFilterTap">已完成</text>
    <text class="filter {{activeFilter === 'failed' ? 'active' : ''}}" data-filter="failed" bindtap="onFilterTap">已失败</text>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <view class="mini-spinner"></view>
    <text class="state-text">加载中</text>
  </view>

  <view wx:elif="{{error}}" class="state-card">
    <view class="state-icon">!</view>
    <text class="state-text error">{{error}}</text>
  </view>

  <block wx:else>
    <view class="record-list">
      <view wx:for="{{tasks}}" wx:key="_id" class="task-item" bindtap="goToTaskDetail" data-id="{{item._id}}">
        <view class="task-thumb">
          <image wx:if="{{item.previewImageHD}}" class="task-thumb-image" src="{{item.previewImageHD}}" mode="aspectFill"></image>
          <text wx:else>{{item.displayInitial}}</text>
        </view>
        <view class="task-main">
          <text class="task-name">{{item.displayName}}</text>
          <text class="task-desc">{{item.displayDesc}}</text>
          <text class="task-time">{{item.timeText}}</text>
        </view>
        <text class="status-chip {{item.statusClass}}">{{item.statusText}}</text>
      </view>
    </view>

    <view wx:if="{{tasks.length === 0}}" class="empty-state">
      <text class="empty-title">暂无生成记录</text>
      <text class="empty-desc">从首页选择一个玩法开始</text>
    </view>

    <view wx:if="{{loadingMore}}" class="load-more">
      <view class="mini-spinner"></view>
      <text class="load-more-text">加载中</text>
    </view>

    <view wx:if="{{!hasMore && tasks.length > 0}}" class="no-more">
      <text class="no-more-text">已展示全部记录</text>
    </view>
  </block>
</view>
