<view class="records-page ui-page">
  <view class="records-nav">
    <view class="records-grid-icon">
      <view></view><view></view><view></view><view></view>
    </view>
    <text class="records-title">处理记录</text>
    <view class="records-nav-spacer"></view>
  </view>

  <scroll-view scroll-x class="filter-scroll" enable-flex show-scrollbar="{{false}}">
    <view class="filter-row">
      <text class="filter-chip {{activeFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onFilterTap">全部</text>
      <text class="filter-chip {{activeFilter === 'pending' ? 'active' : ''}}" data-filter="pending" bindtap="onFilterTap">排队中</text>
      <text class="filter-chip {{activeFilter === 'processing' ? 'active' : ''}}" data-filter="processing" bindtap="onFilterTap">处理中</text>
      <text class="filter-chip {{activeFilter === 'completed' ? 'active' : ''}}" data-filter="completed" bindtap="onFilterTap">已完成</text>
      <text class="filter-chip {{activeFilter === 'failed' ? 'active' : ''}}" data-filter="failed" bindtap="onFilterTap">已失败</text>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="state-card">
    <view class="mini-spinner"></view>
    <text class="state-text">加载中</text>
  </view>

  <view wx:elif="{{error}}" class="state-card">
    <view class="state-icon">!</view>
    <text class="state-text error">{{error}}</text>
  </view>

  <block wx:else>
    <view class="refresh-hint {{refreshing ? 'active' : ''}}">
      <view wx:if="{{refreshing}}" class="mini-spinner"></view>
      <text wx:else class="refresh-icon">↓</text>
      <text>{{refreshing ? '正在同步最新状态' : '下拉刷新同步最新状态'}}</text>
    </view>

    <view class="record-list">
      <view wx:for="{{tasks}}" wx:key="_id" class="task-card" bindtap="goToTaskDetail" data-id="{{item._id}}">
        <view class="task-top">
          <view class="task-left">
            <view class="task-thumb {{item.status === 'failed' ? 'failed' : ''}}">
              <image wx:if="{{item.thumbImage}}" class="task-thumb-image" src="{{item.thumbImage}}" mode="aspectFill"></image>
              <text wx:else>{{item.status === 'failed' ? '!' : item.displayInitial}}</text>
              <view wx:if="{{item.status === 'init' || item.status === 'processing' || item.status === 'pending'}}" class="thumb-mask">中</view>
            </view>
            <view class="task-main">
              <text class="task-name">{{item.displayName}}</text>
              <text class="task-time">{{item.timeText}}</text>
            </view>
          </view>
          <text class="status-chip {{item.statusClass}}">{{item.statusDisplay || item.statusText}}</text>
        </view>

        <view wx:if="{{item.status === 'init' || item.status === 'processing' || item.status === 'pending'}}" class="task-progress">
          <view class="task-progress-fill" style="{{item.progressStyle}}"></view>
        </view>

        <view wx:if="{{item.status === 'completed'}}" class="task-actions">
          <button class="task-action-btn" open-type="share" data-id="{{item._id}}" catchtap="onShareTask">
            <text class="task-action-icon">↗</text>
            <text>分享</text>
          </button>
          <button class="task-action-btn" data-id="{{item._id}}" catchtap="onSaveTaskPoster">
            <text class="task-action-icon">↓</text>
            <text>保存</text>
          </button>
        </view>

        <view wx:if="{{item.status === 'failed'}}" class="task-error">
          <text class="task-error-icon">!</text>
          <text>{{item.errMsgText}}</text>
        </view>

        <button wx:if="{{item.status === 'failed'}}" class="retry-btn" data-type="{{item.type}}" catchtap="retryTask">
          <text class="retry-icon">↻</text>
          <text>重新处理</text>
        </button>

        <text wx:if="{{item.status !== 'completed' && item.status !== 'failed' && item.status !== 'init' && item.status !== 'processing' && item.status !== 'pending'}}" class="task-desc">{{item.displayDesc}}</text>
      </view>
    </view>

    <view wx:if="{{tasks.length === 0}}" class="empty-state">
      <text class="empty-title">暂无处理记录</text>
      <text class="empty-desc">从首页选择一个图片工具开始</text>
    </view>

    <view wx:if="{{loadingMore}}" class="load-more">
      <view class="mini-spinner"></view>
      <text class="load-more-text">加载中</text>
    </view>

    <view wx:if="{{!hasMore && tasks.length > 0}}" class="no-more">
      <text class="no-more-text">已展示全部记录</text>
    </view>
  </block>
</view>
