page {
  background: #fbfcf8;
}

.records-page {
  min-height: 100vh;
  padding: 142rpx 20rpx 118rpx;
}

.records-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  height: 128rpx;
  padding-top: 72rpx;
  background: rgba(251, 252, 248, 0.86);
  backdrop-filter: blur(18rpx);
}

.records-title {
  display: block;
  padding-left: 24rpx;
  color: #17211b;
  font-size: 34rpx;
  font-weight: 900;
}

.filter-row {
  display: flex;
  align-items: center;
  height: 54rpx;
  padding: 0 18rpx 0 8rpx;
}

.filter {
  position: relative;
  flex: 1;
  color: #8b948d;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
}

.filter.active {
  color: #17211b;
}

.filter.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 24rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #15c77a;
  transform: translateX(-50%);
}

.filter-menu {
  width: 42rpx;
  color: #17211b;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
}

.record-list {
  overflow: visible;
  margin-top: 12rpx;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.task-item {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  margin-bottom: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 20rpx rgba(58, 70, 62, 0.045);
}

.task-thumb {
  flex: 0 0 66rpx;
  width: 66rpx;
  height: 66rpx;
  margin-right: 14rpx;
  overflow: hidden;
  border-radius: 13rpx;
  background: linear-gradient(135deg, #ffe4d0, #dff8ee);
  color: #15c77a;
  text-align: center;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 66rpx;
}

.task-thumb image,
.task-thumb-image {
  width: 100%;
  height: 100%;
  display: block;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-name,
.task-desc,
.task-time,
.empty-title,
.empty-desc {
  display: block;
}

.task-name {
  overflow: hidden;
  color: #17211b;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-desc {
  margin-top: 3rpx;
  color: #69736d;
  font-size: 17rpx;
}

.task-time {
  margin-top: 3rpx;
  color: #a0a8a2;
  font-size: 16rpx;
}

.status-chip {
  flex: 0 0 auto;
  min-width: 80rpx;
  margin-left: 12rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 16rpx;
  font-weight: 900;
}

.status-pending {
  color: #b97900;
  background: rgba(255, 212, 93, 0.22);
}

.status-processing {
  color: #2f6fd6;
  background: rgba(78, 140, 255, 0.12);
}

.status-completed {
  color: #0f9f63;
  background: rgba(21, 199, 122, 0.13);
}

.status-failed {
  color: #d85043;
  background: rgba(255, 109, 90, 0.12);
}

.status-refunded {
  color: #7b746e;
  background: rgba(23, 22, 21, 0.06);
}

.state-card {
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  text-align: center;
}

.state-card .mini-spinner {
  margin-bottom: 18rpx;
}

.state-text {
  color: #8b948d;
  font-size: 25rpx;
}

.state-text.error {
  color: #d85043;
}

.state-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 109, 90, 0.14);
  color: #ff6d5a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.empty-state {
  padding: 90rpx 0;
  text-align: center;
}

.empty-title {
  color: #17211b;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  color: #8b948d;
  font-size: 25rpx;
}

.load-more,
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx 0;
}

.load-more .mini-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  border-width: 3rpx;
}

.load-more-text,
.no-more-text {
  color: #8b948d;
  font-size: 24rpx;
}
