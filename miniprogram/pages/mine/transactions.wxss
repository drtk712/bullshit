page {
  background: #f5f2ec;
}

.list-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 60rpx;
}

.list-hero {
  padding: 30rpx;
  margin-bottom: 22rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 82% 12%, rgba(21, 199, 122, 0.56), transparent 30%),
    linear-gradient(135deg, #171615, #3a2c23);
  color: #ffffff;
  box-shadow: 0 20rpx 58rpx rgba(39, 32, 24, 0.16);
}

.hero-kicker,
.hero-title,
.hero-desc,
.transaction-title,
.transaction-time,
.empty-title,
.empty-desc {
  display: block;
}

.hero-kicker {
  color: #ffd45d;
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.12;
}

.hero-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 25rpx;
}

.state-card {
  min-height: 250rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(39, 32, 24, 0.08);
  text-align: center;
}

.state-card .mini-spinner {
  margin-bottom: 18rpx;
}

.state-text {
  color: #8b8580;
  font-size: 26rpx;
}

.state-text.error {
  color: #d85043;
}

.state-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 109, 90, 0.14);
  color: #ff6d5a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.transaction-item {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(39, 32, 24, 0.06);
}

.coin-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
  width: 66rpx;
  height: 66rpx;
  margin-right: 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 212, 93, 0.28);
  color: #9b7210;
  font-size: 22rpx;
  font-weight: 900;
}

.transaction-main {
  flex: 1;
  min-width: 0;
}

.transaction-title {
  overflow: hidden;
  color: #171615;
  font-size: 29rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-time {
  margin-top: 9rpx;
  color: #a49d96;
  font-size: 23rpx;
}

.transaction-amount {
  margin-left: 18rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.amount-plus {
  color: #15c77a;
}

.amount-minus {
  color: #d85043;
}

.empty-state {
  padding: 90rpx 0;
  text-align: center;
}

.empty-title {
  color: #171615;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 12rpx;
  color: #8b8580;
  font-size: 25rpx;
}

.load-more,
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx 0;
}

.load-more .mini-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  border-width: 3rpx;
}

.load-more-text,
.no-more-text {
  color: #8b8580;
  font-size: 24rpx;
}
