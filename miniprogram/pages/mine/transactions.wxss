page {
  background: #f3fcf2;
}

.transactions-page {
  min-height: 100vh;
  padding: 0 var(--ui-page-x) 128rpx;
  box-sizing: border-box;
  background: #f3fcf2;
}

.transaction-title,
.transaction-reason,
.transaction-time,
.transaction-amount,
.transaction-balance,
.empty-title,
.empty-desc {
  display: block;
}

.state-card {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
  text-align: center;
  box-sizing: border-box;
}

.state-card .mini-spinner {
  margin-bottom: 18rpx;
}

.state-text {
  color: var(--ui-text-soft);
  font-size: 26rpx;
}

.state-text.error {
  color: var(--ui-error);
}

.state-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 218, 214, 0.58);
  color: var(--ui-error);
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.refresh-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 56rpx;
  margin: -8rpx 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
  color: var(--ui-text-soft);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.refresh-hint.active {
  background: rgba(21, 199, 122, 0.08);
  color: var(--ui-primary-dark);
}

.refresh-hint .mini-spinner {
  width: 28rpx;
  height: 28rpx;
  border-width: 3rpx;
}

.refresh-icon {
  font-size: 26rpx;
  line-height: 1;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.transaction-item {
  display: flex;
  align-items: center;
  min-height: 124rpx;
  padding: 28rpx;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
  box-sizing: border-box;
}

.coin-thumb {
  flex: 0 0 80rpx;
  width: 80rpx;
  height: 80rpx;
  margin-right: 22rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 80rpx;
}

.coin-thumb.income {
  background: rgba(21, 199, 122, 0.12);
  color: var(--ui-primary-dark);
}

.coin-thumb.expense {
  background: rgba(255, 218, 214, 0.58);
  color: var(--ui-error);
}

.transaction-main {
  flex: 1;
  min-width: 0;
}

.transaction-title {
  overflow: hidden;
  color: var(--ui-text);
  font-size: 31rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-time {
  margin-top: 6rpx;
  color: var(--ui-text-soft);
  font-size: 25rpx;
  line-height: 34rpx;
}

.transaction-reason {
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--ui-text-soft);
  font-size: 22rpx;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.transaction-side {
  flex: 0 0 auto;
  min-width: 120rpx;
  margin-left: 18rpx;
  text-align: right;
}

.transaction-amount {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.transaction-balance {
  margin-top: 6rpx;
  color: var(--ui-text-soft);
  font-size: 22rpx;
  line-height: 30rpx;
}

.amount-plus {
  color: var(--ui-primary-dark);
}

.amount-minus {
  color: var(--ui-error);
}

.empty-state {
  padding: 120rpx 0;
  text-align: center;
}

.empty-title {
  color: var(--ui-text);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.empty-desc {
  margin-top: 12rpx;
  color: var(--ui-text-soft);
  font-size: 25rpx;
  line-height: 36rpx;
}

.load-more,
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx 0;
}

.load-more .mini-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  border-width: 3rpx;
}

.load-more-text,
.no-more-text {
  color: var(--ui-text-soft);
  font-size: 24rpx;
}
