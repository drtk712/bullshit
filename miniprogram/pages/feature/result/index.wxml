<view class="result-page flow-page">
  <app-nav title="{{task.displayName}}结果" bind:back="goBack"></app-nav>

  <view wx:if="{{loading}}" class="state-card">
    <view class="mini-spinner"></view>
    <text class="state-text">正在加载结果</text>
  </view>

  <view wx:elif="{{error}}" class="state-card">
    <view class="state-icon">!</view>
    <text class="state-text error">{{error}}</text>
  </view>

  <block wx:else>
    <view class="result-tabs">
      <text class="result-tab {{activeTab === 'result' ? 'active' : ''}}" data-tab="result" bindtap="switchTab">结果</text>
      <text class="result-tab {{activeTab === 'original' ? 'active' : ''}}" data-tab="original" bindtap="switchTab">原图</text>
    </view>

    <view class="poster-card">
      <view wx:if="{{activeTab === 'result'}}" class="poster-frame" bindtap="viewPoster">
        <image wx:if="{{posterPreviewUrl}}" class="poster-image" src="{{posterPreviewUrl}}" mode="aspectFill"></image>
        <view wx:else class="poster-placeholder">{{posterError || '图片加载中'}}</view>
      </view>

      <view wx:elif="{{activeTab === 'original'}}" class="poster-frame" bindtap="viewPoster">
        <image wx:if="{{originalImageUrl}}" class="poster-image" src="{{originalImageUrl}}" mode="aspectFill"></image>
        <view wx:else class="poster-placeholder">原图加载中</view>
      </view>

      <view class="poster-watermark">玩图局</view>
    </view>

    <view wx:if="{{activeTab === 'result' && resultUrls.length > 0}}" class="result-pieces">
      <view class="pieces-heading">
        <text class="pieces-title">切分结果</text>
        <text class="pieces-count">{{resultUrls.length}} 张</text>
      </view>
      <view class="pieces-grid">
        <view class="piece-card" wx:for="{{resultUrls}}" wx:key="*this">
          <image class="piece-image" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="viewResultPiece"></image>
          <view class="piece-save" data-index="{{index}}" bindtap="saveResultPiece">保存</view>
        </view>
      </view>
    </view>

    <view class="result-dock">
      <button class="save-btn" bindtap="savePoster">↓ 保存到相册</button>
      <button class="share-btn" open-type="share">↗ 分享给朋友</button>
    </view>
  </block>
</view>
