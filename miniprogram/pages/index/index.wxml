<view class="home-page ui-page">
  <view class="home-appbar">
    <view class="appbar-icon">□</view>
    <text class="appbar-title">玩图局</text>
    <view class="appbar-spacer"></view>
  </view>

  <view class="home-top">
    <text class="hello">Hi，玩图达人 👋</text>
    <text class="sub-hello">今天想玩点什么呢？</text>
  </view>

  <view wx:if="{{loadingFeatures}}" class="state-card">
    <view class="mini-spinner"></view>
    <view class="state-text">玩法加载中</view>
  </view>

  <view wx:elif="{{featureError}}" class="state-card">
    <view class="state-icon warn">!</view>
    <view class="state-title">加载失败</view>
    <view class="state-text error">{{featureError}}</view>
  </view>

  <block wx:else>
    <view class="recommend-card" bindtap="onClickRecommend">
      <view class="recommend-copy">
        <text class="recommend-title">{{recommendedFeature.title}}</text>
        <text class="recommend-desc" wx:if="{{recommendedFeature.description}}">{{recommendedFeature.description}}</text>
        <view class="recommend-btn">去玩一玩 <text>→</text></view>
      </view>
      <view class="recommend-art">
        <image
          wx:if="{{recommendedFeature.previewImageHD}}"
          class="recommend-image"
          src="{{recommendedFeature.previewImageHD}}"
          mode="aspectFill"
          lazy-load
        />
        <view wx:else class="recommend-fallback">▧</view>
      </view>
    </view>

    <scroll-view scroll-x class="category-row" enable-flex>
      <view class="category-chip {{item.key === activeCategory ? 'active' : ''}}" wx:for="{{categories}}" wx:key="key" data-category="{{item.key}}" bindtap="onCategoryTap">
        <text>{{item.icon}}</text>
        <text>{{item.text}}</text>
      </view>
    </scroll-view>

    <view class="feature-grid">
      <view
        class="feature-card feature-card-{{item.cardSize}}"
        wx:for="{{filteredFeatureList}}"
        wx:key="type"
        data-type="{{item.type}}"
        bindtap="onClickFeature"
      >
        <view class="feature-media">
          <block wx:if="{{item.previewImageHD}}">
            <image
              class="feature-preview"
              src="{{item.previewImageHD}}"
              mode="aspectFill"
              lazy-load
            />
            <view
              class="feature-preview-button"
              data-index="{{index}}"
              catchtap="onPreviewImageTap"
              aria-label="预览"
            >⌕</view>
          </block>
          <text wx:else class="feature-emoji">▧</text>
        </view>
        <view class="feature-info">
          <text class="feature-title">{{item.title}}</text>
          <text class="feature-desc">{{item.homeDesc}}</text>
        </view>
      </view>
      <view wx:if="{{filteredFeatureList.length === 0}}" class="empty-card">
        <text>暂无功能</text>
      </view>
    </view>
  </block>

</view>
