<view class="container">
  <view class="header">
    <view class="title">玩图局</view>
    <view class="subtitle">选个主题，生成你的专属解读</view>
  </view>

  <view wx:if="{{loadingFeatures}}" class="state-card">
    <view class="loading-spinner"></view>
    <view class="state-text">正在加载功能</view>
  </view>

  <view wx:elif="{{featureError}}" class="state-card">
    <view class="state-text error">{{featureError}}</view>
  </view>

  <view wx:else class="power-list">
    <view
      class="power-item"
      wx:for="{{featureList}}"
      wx:key="type"
      data-url="{{item.route}}"
      bindtap="onClickFeature"
    >
      <view class="power-item-icon">{{item.icon}}</view>
      <view class="power-item-content">
        <view class="power-item-title">{{item.title}}</view>
        <view class="power-item-tip">{{item.description}}</view>
      </view>
      <view class="power-item-arrow">›</view>
    </view>
  </view>
</view>
