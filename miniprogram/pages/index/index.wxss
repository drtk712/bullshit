page {
  background:
    -webkit-radial-gradient(85% 4%, circle, rgba(255, 238, 185, 0.9), transparent 24%),
    -webkit-radial-gradient(6% 0%, circle, rgba(206, 255, 225, 0.9), transparent 20%),
    #fbfcf8;
  background:
    radial-gradient(circle at 85% 4%, rgba(255, 238, 185, 0.9), transparent 24%),
    radial-gradient(circle at 6% 0%, rgba(206, 255, 225, 0.9), transparent 20%),
    #fbfcf8;
}

.home-page {
  min-height: 100vh;
  padding: 80rpx 40rpx 120rpx;
  color: #17211b;
}

.home-top {
  position: relative;
  padding-top: 0;
}

.page-brand,
.hello,
.sub-hello,
.recommend-kicker,
.recommend-title,
.recommend-desc,
.section-title,
.feature-title,
.feature-desc {
  display: block;
}

.page-brand {
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hello {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.sub-hello {
  margin-top: 10rpx;
  color: #9aa29c;
  font-size: 24rpx;
}

.recommend-card {
  position: relative;
  display: flex;
  height: 360rpx;
  min-height: 360rpx;
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background:
    -webkit-radial-gradient(80% 20%, circle, rgba(180, 213, 255, 0.9), transparent 40%),
    -webkit-radial-gradient(10% 90%, circle, rgba(255, 190, 200, 0.6), transparent 35%),
    -webkit-linear-gradient(135deg, #fff7ed, #e0f2fe);
  background:
    radial-gradient(circle at 80% 20%, rgba(180, 213, 255, 0.9), transparent 40%),
    radial-gradient(circle at 10% 90%, rgba(255, 190, 200, 0.6), transparent 35%),
    linear-gradient(135deg, #fff7ed, #e0f2fe);
  box-shadow: 0 16rpx 40rpx rgba(74, 82, 76, 0.12);
}

.recommend-copy {
  position: relative;
  z-index: 3;
  width: 48%;
  padding: 32rpx 0 32rpx 28rpx;
}

.recommend-kicker {
  color: #92400e;
  font-size: 24rpx;
  font-weight: 800;
}

.recommend-title {
  margin-top: 10rpx;
  color: #151815;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.05;
}

.recommend-desc {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.4;
}

.recommend-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 60rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: -webkit-linear-gradient(135deg, #10b981, #059669);
  background: linear-gradient(135deg, #10b981, #059669);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.35);
}

.recommend-art {
  position: relative;
  flex: 1;
  min-width: 0;
}

.recommend-image {
  position: absolute;
  right: -20rpx;
  bottom: -10rpx;
  z-index: 2;
  width: 360rpx;
  height: 320rpx;
  opacity: 1;
  transition: opacity 0.24s ease;
}

.recommend-fallback {
  position: absolute;
  right: 70rpx;
  bottom: 80rpx;
  z-index: 1;
  font-size: 140rpx;
}

.spark {
  position: absolute;
  z-index: 4;
  color: rgba(255, 255, 255, 0.95);
  font-size: 32rpx;
  font-weight: 900;
}

.spark-a {
  left: 12rpx;
  top: 48rpx;
}

.spark-b {
  right: 40rpx;
  top: 60rpx;
  font-size: 24rpx;
  color: #bfdbfe;
}

.spark-c {
  right: 20rpx;
  bottom: 100rpx;
  font-size: 20rpx;
  color: #fecaca;
}

.category-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  white-space: nowrap;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #5a665f;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 18rpx rgba(63, 74, 67, 0.08);
  transition: all 0.2s ease;
}

.category-chip text + text {
  margin-left: 6rpx;
}

.category-chip.active {
  background: -webkit-linear-gradient(135deg, #10b981, #059669);
  background: linear-gradient(135deg, #10b981, #059669);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.3);
}

.section-head {
  margin: 32rpx 0 18rpx;
}

.section-title {
  color: #17211b;
  font-size: 30rpx;
  font-weight: 900;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.feature-card {
  flex: 0 0 calc((100% - 20rpx) / 2);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 20rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(62, 72, 66, 0.08);
}

.feature-palm {
  background: -webkit-linear-gradient(135deg, #e8f8f0, #f0fdf4);
  background: linear-gradient(135deg, #e8f8f0, #f0fdf4);
  border: 1rpx solid rgba(74, 222, 172, 0.35);
}

.feature-hair {
  background: -webkit-linear-gradient(135deg, #fff7ed, #ffedd5);
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  border: 1rpx solid rgba(251, 146, 60, 0.25);
}

.feature-profile {
  background: -webkit-linear-gradient(135deg, #fefce8, #fef9c3);
  background: linear-gradient(135deg, #fefce8, #fef9c3);
  border: 1rpx solid rgba(234, 179, 8, 0.25);
}

.feature-doodle {
  background: -webkit-linear-gradient(135deg, #eff6ff, #dbeafe);
  background: linear-gradient(135deg, #eff6ff, #dbeafe);
  border: 1rpx solid rgba(59, 130, 246, 0.25);
}

.feature-soul {
  background: -webkit-linear-gradient(135deg, #f5f3ff, #ede9fe);
  background: linear-gradient(135deg, #f5f3ff, #ede9fe);
  border: 1rpx solid rgba(139, 92, 246, 0.25);
}

/* 图标区域 - 较大的方形 */
.feature-icon-box {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
}

.feature-preview {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  opacity: 1;
  transition: opacity 0.2s ease;
}

.feature-emoji {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

/* 玩法信息 */
.feature-info {
  width: 100%;
  text-align: center;
}

.feature-title {
  overflow: hidden;
  color: #18211c;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-desc {
  overflow: hidden;
  margin-top: 8rpx;
  color: #8a938d;
  font-size: 22rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-card,
.empty-card {
  min-height: 230rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  text-align: center;
  box-shadow: 0 12rpx 30rpx rgba(62, 72, 66, 0.08);
}

.state-card .mini-spinner {
  margin-bottom: 18rpx;
}

.state-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 109, 90, 0.14);
  color: #ff6d5a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.state-title {
  margin-bottom: 8rpx;
  color: #17211b;
  font-size: 28rpx;
  font-weight: 900;
}

.state-text,
.empty-card {
  color: #8a938d;
  font-size: 25rpx;
}

.state-text.error {
  color: #ff6d5a;
}
