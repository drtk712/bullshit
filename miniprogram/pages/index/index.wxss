page {
  background:
    radial-gradient(circle at 85% 4%, rgba(255, 238, 185, 0.9), transparent 24%),
    radial-gradient(circle at 6% 0%, rgba(206, 255, 225, 0.9), transparent 20%),
    #fbfcf8;
}

.home-page {
  min-height: 100vh;
  padding: 68rpx 38rpx 118rpx;
  color: #17211b;
}

.home-top {
  position: relative;
  padding-top: 0;
}

.page-brand,
.hello,
.sub-hello,
.recommend-kicker,
.recommend-title,
.recommend-desc,
.section-title,
.feature-title,
.feature-desc {
  display: block;
}

.page-brand {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hello {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
}

.sub-hello {
  margin-top: 8rpx;
  color: #9aa29c;
  font-size: 22rpx;
}

.recommend-card {
  position: relative;
  display: flex;
  height: 336rpx;
  min-height: 336rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 84% 16%, rgba(150, 213, 255, 0.95), transparent 36%),
    radial-gradient(circle at 0% 100%, rgba(255, 174, 215, 0.72), transparent 34%),
    linear-gradient(135deg, #ffe7ba, #d7eefc);
  box-shadow: 0 14rpx 32rpx rgba(74, 82, 76, 0.1);
}

.recommend-copy {
  position: relative;
  z-index: 3;
  width: 42%;
  padding: 24rpx 0 24rpx 26rpx;
}

.recommend-kicker {
  color: #9a6a18;
  font-size: 22rpx;
  font-weight: 800;
}

.recommend-title {
  margin-top: 8rpx;
  color: #151815;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.02;
}

.recommend-desc {
  margin-top: 6rpx;
  color: #6f756e;
  font-size: 21rpx;
  line-height: 1.32;
}

.recommend-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 146rpx;
  height: 56rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #14c878;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  box-shadow: 0 7rpx 16rpx rgba(20, 200, 120, 0.28);
}

.recommend-art {
  position: relative;
  flex: 1;
  min-width: 0;
}

.recommend-image {
  position: absolute;
  right: -12rpx;
  bottom: -8rpx;
  z-index: 2;
  width: 344rpx;
  height: 302rpx;
  opacity: 0;
  transition: opacity 0.24s ease;
}

.recommend-image.loaded {
  opacity: 1;
}

.recommend-fallback {
  position: absolute;
  right: 84rpx;
  bottom: 74rpx;
  z-index: 1;
  font-size: 132rpx;
}

.spark {
  position: absolute;
  z-index: 4;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
}

.spark.s1 {
  left: 8rpx;
  top: 54rpx;
}

.spark.s2 {
  right: 30rpx;
  top: 82rpx;
  color: #a4d4ff;
}

.category-row {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.category-chip {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  height: 38rpx;
  padding: 0 13rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #4e5752;
  font-size: 18rpx;
  font-weight: 700;
  box-shadow: 0 5rpx 14rpx rgba(63, 74, 67, 0.06);
}

.category-chip text + text {
  margin-left: 4rpx;
}

.category-chip.active {
  color: #ff5f44;
}

.section-head {
  margin: 24rpx 0 14rpx;
}

.section-title {
  color: #17211b;
  font-size: 28rpx;
  font-weight: 900;
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.feature-card {
  flex: 0 0 calc((100% - 14rpx) / 2);
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 22rpx rgba(62, 72, 66, 0.06);
}

.feature-palm {
  background: #eefcf6;
  border: 1rpx solid rgba(89, 224, 176, 0.42);
}

.feature-hair,
.feature-doodle {
  background: #fff3ec;
}

.feature-profile {
  background: #fff9ef;
}

.feature-soul {
  background: #f3efff;
}

.feature-thumb {
  position: relative;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #ffffff;
}

.feature-preview {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.feature-preview.loaded {
  opacity: 1;
}

.feature-emoji {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  width: 72rpx;
  height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  line-height: 72rpx;
}

.feature-copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.feature-title {
  overflow: hidden;
  color: #18211c;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-desc {
  overflow: hidden;
  margin-top: 6rpx;
  color: #8a938d;
  font-size: 22rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-card,
.empty-card {
  min-height: 230rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  text-align: center;
  box-shadow: 0 12rpx 30rpx rgba(62, 72, 66, 0.08);
}

.state-card .mini-spinner {
  margin-bottom: 18rpx;
}

.state-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 109, 90, 0.14);
  color: #ff6d5a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.state-title {
  margin-bottom: 8rpx;
  color: #17211b;
  font-size: 28rpx;
  font-weight: 900;
}

.state-text,
.empty-card {
  color: #8a938d;
  font-size: 25rpx;
}

.state-text.error {
  color: #ff6d5a;
}
