page {
  background: var(--ui-bg);
}

.home-page {
  min-height: 100vh;
  padding-top: 180rpx;
  padding-bottom: 120rpx;
}

.home-appbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 144rpx;
  padding: 0 var(--ui-page-x) 22rpx;
  background: rgba(243, 252, 242, 0.86);
  box-shadow: var(--ui-shadow);
  backdrop-filter: blur(40rpx);
}

.appbar-icon,
.appbar-spacer {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--ui-radius-full);
}

.appbar-icon {
  color: var(--ui-primary-dark);
  font-size: 34rpx;
  font-weight: 800;
}

.appbar-title {
  color: var(--ui-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.home-top,
.recommend-card,
.category-row,
.feature-grid {
  position: relative;
}

.hello,
.sub-hello,
.recommend-title,
.recommend-desc,
.feature-title,
.feature-desc {
  display: block;
}

.home-top {
  display: flex;
  flex-direction: column;
  gap: var(--ui-gap-xs);
}

.hello {
  color: var(--ui-text);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.sub-hello {
  color: var(--ui-muted);
  font-size: 28rpx;
  line-height: 40rpx;
}

.recommend-card {
  display: flex;
  min-height: 290rpx;
  margin-top: var(--ui-gap-lg);
  padding: var(--ui-gap-md);
  overflow: hidden;
  border-radius: var(--ui-radius-lg);
  background:
    radial-gradient(circle at 8% 0%, rgba(101, 254, 170, 0.18), transparent 36%),
    var(--ui-card);
  box-shadow: var(--ui-shadow);
}

.recommend-copy {
  position: relative;
  z-index: 2;
  width: 60%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.recommend-title {
  color: var(--ui-text);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.recommend-desc {
  margin-top: var(--ui-gap-sm);
  color: var(--ui-muted);
  font-size: 28rpx;
  line-height: 40rpx;
}

.recommend-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 72rpx;
  margin-top: var(--ui-gap-md);
  padding: 0 32rpx;
  border-radius: var(--ui-radius-xl);
  background: var(--ui-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 40rpx rgba(21, 199, 122, 0.2);
}

.recommend-art {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 40%;
  overflow: hidden;
  border-top-right-radius: var(--ui-radius-lg);
  border-bottom-right-radius: var(--ui-radius-lg);
  background: var(--ui-surface-low);
}

.recommend-image {
  width: 100%;
  height: 100%;
  opacity: 0.82;
  border-top-left-radius: 80rpx;
  border-bottom-left-radius: 80rpx;
}

.recommend-fallback {
  position: absolute;
  left: 0;
  right: 0;
  top: 94rpx;
  text-align: center;
  font-size: 112rpx;
}

.category-row {
  display: flex;
  margin: var(--ui-gap-lg) calc(var(--ui-page-x) * -1) 0;
  padding: 0 var(--ui-page-x) 8rpx;
  white-space: nowrap;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  margin-right: var(--ui-gap-sm);
  padding: 0 32rpx;
  border-radius: var(--ui-radius-full);
  background: var(--ui-surface-low);
  color: var(--ui-text-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.category-chip text + text {
  margin-left: 8rpx;
}

.category-chip.active {
  border: 1rpx solid var(--ui-primary);
  background: var(--ui-primary-soft);
  color: var(--ui-primary-dark);
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: var(--ui-gap-lg);
}

.feature-card {
  flex: 0 0 calc((100% - 24rpx) / 2);
  overflow: hidden;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
}

.feature-card-wide {
  flex-basis: 100%;
}

.feature-media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--ui-surface-high);
}

.feature-card-wide .feature-media {
  aspect-ratio: 3 / 1;
}

.feature-preview {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
}

.feature-emoji {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 1;
  text-align: center;
  font-size: 72rpx;
  transform: translateY(-50%);
}

.feature-info {
  padding: 20rpx 24rpx 22rpx;
}

.feature-title {
  overflow: hidden;
  color: var(--ui-text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-desc {
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--ui-muted);
  font-size: 24rpx;
  line-height: 32rpx;
  opacity: 0.82;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-card,
.empty-card {
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: var(--ui-gap-lg);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  color: var(--ui-muted);
  text-align: center;
  box-shadow: var(--ui-shadow);
}

.state-card .mini-spinner {
  margin-bottom: var(--ui-gap-sm);
}

.state-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: var(--ui-gap-sm);
  border-radius: var(--ui-radius-full);
  background: var(--ui-error-soft);
  color: var(--ui-error);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.state-title {
  margin-bottom: var(--ui-gap-xs);
  color: var(--ui-text);
  font-size: 30rpx;
  font-weight: 800;
}

.state-text {
  color: var(--ui-muted);
  font-size: 26rpx;
}

.state-text.error {
  color: var(--ui-error);
}
