page {
  background: var(--ui-bg);
}

.home-page {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: 120rpx;
}

.home-top,
.recommend-card,
.category-row,
.feature-grid {
  position: relative;
}

.hello,
.sub-hello,
.recommend-title,
.recommend-desc,
.feature-title,
.feature-desc {
  display: block;
}

.home-top {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: var(--ui-gap-xs);
}

.hello {
  color: var(--ui-text);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.sub-hello {
  color: var(--ui-muted);
  font-size: 28rpx;
  line-height: 40rpx;
}

.recommend-card {
  display: flex;
  min-height: 290rpx;
  margin-top: var(--ui-gap-lg);
  padding: var(--ui-gap-md);
  overflow: hidden;
  border-radius: var(--ui-radius-lg);
  background:
    radial-gradient(circle at 8% 0%, rgba(101, 254, 170, 0.18), transparent 36%),
    var(--ui-card);
  box-shadow: var(--ui-shadow);
}

.refresh-toast {
  position: fixed;
  left: 50%;
  top: 150rpx;
  z-index: 25;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 24rpx;
  border-radius: var(--ui-radius-full);
  background: rgba(255, 255, 255, 0.94);
  color: var(--ui-primary-dark);
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 36rpx rgba(18, 84, 54, 0.14);
  transform: translateX(-50%);
}

.refresh-toast.done::before {
  content: "✓";
  margin-right: 8rpx;
}

.recommend-copy {
  position: relative;
  z-index: 2;
  width: 60%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.recommend-title {
  color: var(--ui-text);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.recommend-desc {
  margin-top: var(--ui-gap-sm);
  color: var(--ui-muted);
  font-size: 28rpx;
  line-height: 40rpx;
}

.recommend-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 72rpx;
  margin-top: var(--ui-gap-md);
  padding: 0 32rpx;
  border-radius: var(--ui-radius-xl);
  background: var(--ui-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 40rpx rgba(21, 199, 122, 0.2);
}

.recommend-art {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 40%;
  overflow: hidden;
  border-top-right-radius: var(--ui-radius-lg);
  border-bottom-right-radius: var(--ui-radius-lg);
  background: var(--ui-surface-low);
}

.recommend-image {
  width: 100%;
  height: 100%;
  opacity: 0.82;
  border-top-left-radius: 80rpx;
  border-bottom-left-radius: 80rpx;
}

.recommend-fallback {
  position: absolute;
  left: 0;
  right: 0;
  top: 94rpx;
  text-align: center;
  font-size: 112rpx;
}

.category-row {
  display: flex;
  margin: var(--ui-gap-lg) calc(var(--ui-page-x) * -1) 0;
  padding: 0 var(--ui-page-x) 8rpx;
  white-space: nowrap;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  margin-right: 12rpx;
  padding: 0 18rpx;
  border-radius: var(--ui-radius-full);
  border: 1rpx solid rgba(108, 123, 111, 0.14);
  background: rgba(232, 240, 231, 0.72);
  color: var(--ui-text-soft);
  font-size: 20rpx;
  font-weight: 600;
}

.category-chip text + text {
  margin-left: 6rpx;
}

.category-chip text:first-child {
  font-size: 20rpx;
  line-height: 1;
}

.category-chip.active {
  border-color: rgba(21, 199, 122, 0.9);
  background: rgba(101, 254, 170, 0.12);
  color: var(--ui-primary-dark);
}

.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: var(--ui-gap-lg);
}

.feature-card {
  flex: 0 0 calc((100% - 24rpx) / 2);
  overflow: hidden;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
}

.feature-card-wide {
  flex-basis: 100%;
}

.feature-media {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--ui-surface-high);
}

.feature-card-wide .feature-media {
  aspect-ratio: 3 / 1;
}

.feature-preview {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
}

.feature-preview-button {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: var(--ui-radius-full);
  background: rgba(20, 32, 27, 0.28);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 72rpx;
  transform: none;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.16);
  backdrop-filter: blur(16rpx);
}

.feature-preview-button:active {
  background: rgba(20, 32, 27, 0.38);
  transform: scale(0.96);
}

.feature-emoji {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 1;
  text-align: center;
  font-size: 72rpx;
  transform: translateY(-50%);
}

.feature-info {
  padding: 20rpx 24rpx 22rpx;
}

.feature-title {
  overflow: hidden;
  color: var(--ui-text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-desc {
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--ui-muted);
  font-size: 24rpx;
  line-height: 32rpx;
  opacity: 0.82;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-card,
.empty-card {
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: var(--ui-gap-lg);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  color: var(--ui-muted);
  text-align: center;
  box-shadow: var(--ui-shadow);
}

.state-card .mini-spinner {
  margin-bottom: var(--ui-gap-sm);
}

.state-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: var(--ui-gap-sm);
  border-radius: var(--ui-radius-full);
  background: var(--ui-error-soft);
  color: var(--ui-error);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.state-title {
  margin-bottom: var(--ui-gap-xs);
  color: var(--ui-text);
  font-size: 30rpx;
  font-weight: 800;
}

.state-text {
  color: var(--ui-muted);
  font-size: 26rpx;
}

.state-text.error {
  color: var(--ui-error);
}
