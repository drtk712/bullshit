page {
  background: #f7f7f7;
}

.container {
  min-height: 100vh;
  padding: 48rpx 30rpx 120rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 52rpx;
  padding-top: 28rpx;
}

.title {
  color: #111111;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  margin-top: 14rpx;
  color: #888888;
  font-size: 28rpx;
}

.power-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.power-item,
.state-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.power-item {
  justify-content: space-between;
  transition: transform 0.2s;
}

.power-item:active {
  transform: scale(0.98);
}

.power-item-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  background: #f0fbf5;
  font-size: 48rpx;
}

.power-item-content {
  flex: 1;
}

.power-item-title {
  margin-bottom: 8rpx;
  color: #111111;
  font-size: 34rpx;
  font-weight: 600;
}

.power-item-tip {
  color: #8a8a8a;
  font-size: 25rpx;
  line-height: 1.5;
}

.power-item-arrow {
  margin-left: 20rpx;
  color: #bbbbbb;
  font-size: 46rpx;
}

.state-card {
  min-height: 220rpx;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.state-text {
  color: #888888;
  font-size: 27rpx;
}

.state-text.error {
  color: #e64340;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 20rpx;
  border: 6rpx solid #eeeeee;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
