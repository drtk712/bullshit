page {
  background: linear-gradient(180deg, #f8f9ff 0%, #ffffff 100%);
}

.container {
  padding: 40rpx 30rpx;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
}

.power-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.power-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.2s;
}

.power-item:active {
  transform: scale(0.98);
}

.power-item-content {
  flex: 1;
}

.power-item-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.power-item-tip {
  font-size: 24rpx;
  color: #999;
}

.power-item-arrow {
  font-size: 40rpx;
  color: #999;
  margin-left: 20rpx;
}
