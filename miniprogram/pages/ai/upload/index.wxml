<view class="upload-page flow-page">
  <view class="flow-nav upload-nav">
    <view class="flow-back" bindtap="goBack">‹</view>
    <text class="flow-title">上传照片</text>
    <view class="flow-spacer"></view>
  </view>

  <view wx:if="{{configLoading}}" class="state-card">
    <view class="mini-spinner"></view>
    <text class="state-text">正在准备玩法</text>
  </view>

  <view wx:elif="{{configError}}" class="state-card">
    <view class="state-icon">!</view>
    <text class="state-text error">{{configError}}</text>
  </view>

  <block wx:else>
    <view class="upload-box" bindtap="chooseImage">
      <view class="camera-bubble">▧</view>
      <text class="upload-title">{{feature.uploadTitle}}</text>
      <text class="upload-sub">支持 JPG, PNG, HEIC 格式</text>
    </view>

    <view class="tips-card">
      <view class="tips-heading">
        <text class="tips-icon">◆</text>
        <text class="tips-title">拍照小贴士</text>
      </view>
      <view class="tip-item" wx:for="{{tips}}" wx:key="*this">
        <text class="check-dot">✓</text>
        <text>{{item}}</text>
      </view>
    </view>

    <view class="balance-card">
      <view class="balance-left">
        <text class="balance-icon">✦</text>
        <text class="balance-label">本次消耗</text>
      </view>
      <view class="balance-right">
        <text class="cost-number">1</text>
        <text class="balance-text">当前余额: {{points}}</text>
      </view>
    </view>

    <view class="upload-dock">
      <button class="generate-btn" bindtap="chooseImage">开始生成</button>
    </view>

    <view wx:if="{{showPointsModal}}" class="modal-mask">
      <view class="modal-card">
        <view class="modal-close" bindtap="hidePointsModal">×</view>
        <view class="coin-art error">!</view>
        <text class="modal-title">积分不足</text>
        <text class="modal-desc">{{shareRewardCopy.canEarn ? '今日还可通过分享获得 ' + shareRewardStatus.remainingToday + ' 积分' : '今日分享积分已达上限，请明日再来'}}</text>
        <view class="modal-actions">
          <button class="modal-secondary" bindtap="hidePointsModal">取消</button>
          <button wx:if="{{shareRewardCopy.canEarn}}" class="modal-btn" open-type="share">分享得积分</button>
          <button wx:else class="modal-btn" bindtap="hidePointsModal">知道了</button>
        </view>
      </view>
    </view>
  </block>
</view>
