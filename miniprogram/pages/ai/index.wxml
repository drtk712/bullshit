<view class="ai-page">
  <view class="custom-nav">
    <view class="nav-icon" bindtap="goBack">‹</view>
    <text class="nav-title">{{feature.title || '看手相'}}</text>
  </view>

  <view wx:if="{{configLoading}}" class="state-panel">
    <view class="mini-spinner"></view>
    <text class="state-title">正在准备玩法</text>
  </view>

  <view wx:elif="{{configError}}" class="state-panel">
    <view class="state-icon">!</view>
    <text class="state-title">玩法暂不可用</text>
    <text class="state-desc error">{{configError}}</text>
  </view>

  <view wx:else class="detail-content">
    <view class="detail-head">
      <text class="detail-kicker">趣味{{feature.title}}解读</text>
      <text class="detail-title">探索你的天赋、性格与运势</text>
      <view class="tag-row">
        <text class="tag">◎ 趣味解读</text>
        <text class="tag">◉ 专业分析</text>
        <text class="tag">♡ 精美海报</text>
      </view>
    </view>

    <view class="showcase">
      <view class="report-card" catchtap="previewFeatureImage">
        <image
          wx:if="{{feature.previewImageHD}}"
          class="report-image {{feature._imageLoaded ? 'loaded' : ''}}"
          src="{{feature.previewImageHD}}"
          mode="aspectFill"
          lazy-load
          bindload="onFeatureImageLoad"
          binderror="onFeatureImageError"
        />
        <view class="report-fallback">{{feature.icon}}</view>
        <text class="report-title">{{reportTitle}}</text>
        <view class="magnifier">⌕</view>
      </view>
      <view class="analysis-list">
        <view class="analysis-item" wx:for="{{analysisItems}}" wx:key="title">
          <text class="analysis-title">{{item.title}}</text>
          <text class="analysis-desc" wx:for="{{item.items}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view class="carousel-dots">
        <text class="dot active"></text>
        <text class="dot"></text>
        <text class="dot"></text>
        <text class="dot"></text>
      </view>
    </view>

    <view class="require-card">
      <view class="card-row head">
        <text class="card-title">上传要求</text>
        <text class="card-arrow">⌄</text>
      </view>
      <view class="require-item" wx:for="{{requirements}}" wx:key="*this">
        <text class="check-dot">✓</text>
        <text>{{item}}</text>
      </view>
    </view>

    <view class="bottom-dock">
      <view class="dock-cost">消耗 <text>1</text> 积分</view>
      <button class="start-btn" bindtap="startUpload">立即上传 →</button>
    </view>
  </view>
</view>
