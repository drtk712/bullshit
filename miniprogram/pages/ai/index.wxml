<view class="ai-page ui-page">
  <view class="custom-nav">
    <view class="nav-icon" bindtap="goBack">‹</view>
    <text class="nav-title">{{feature.title || '看手相'}}</text>
    <view class="nav-spacer"></view>
  </view>

  <view wx:if="{{configLoading}}" class="state-panel">
    <view class="mini-spinner"></view>
    <text class="state-title">正在准备玩法</text>
  </view>

  <view wx:elif="{{configError}}" class="state-panel">
    <view class="state-icon">!</view>
    <text class="state-title">玩法暂不可用</text>
    <text class="state-desc error">{{configError}}</text>
  </view>

  <view wx:else class="detail-content">
    <view class="detail-head">
      <text class="detail-kicker">{{detailTitle || feature.title}}</text>
      <text class="detail-title">{{detailSubtitle}}</text>
      <view class="tag-row">
        <text class="tag" wx:for="{{detailTags}}" wx:key="text">{{item.text}}</text>
      </view>
    </view>

    <view class="example-card">
      <view class="section-heading">
        <text class="section-icon">▤</text>
        <text class="section-title">示例报告</text>
      </view>

      <view class="example-grid">
        <view class="example-preview" catchtap="previewFeatureImage">
          <image
            wx:if="{{feature.previewImageHD}}"
            class="report-image {{feature._imageLoaded ? 'loaded' : ''}}"
            src="{{feature.previewImageHD}}"
            mode="aspectFill"
            lazy-load
            bindload="onFeatureImageLoad"
            binderror="onFeatureImageError"
          />
          <view class="report-fallback">▧</view>
          <view class="scan-line"></view>
        </view>

        <view class="analysis-list">
          <view class="analysis-card {{item.tone}}" wx:for="{{detailAnalysis}}" wx:key="title">
            <view class="analysis-dot"></view>
            <view>
              <text class="analysis-title">{{item.title}}</text>
              <text class="analysis-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="require-card">
      <view class="section-heading">
        <text class="section-icon">▣</text>
        <text class="section-title">拍摄要求</text>
      </view>
      <view class="require-grid">
        <view class="require-item" wx:for="{{requirementItems}}" wx:key="text">
          <view class="require-icon">✓</view>
          <text>{{item.text}}</text>
        </view>
      </view>
    </view>

    <view class="bottom-dock">
      <view class="dock-cost">
        <text class="cost-label">本次消耗</text>
        <text class="cost-value">1 积分</text>
      </view>
      <button class="start-btn" bindtap="startUpload">立即上传 →</button>
    </view>
  </view>
</view>
