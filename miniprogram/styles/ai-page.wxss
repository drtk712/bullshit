page {
  background: #f7f7f7;
}

.ai-page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.feature-card,
.test-toggle,
.upload-card,
.error-card,
.status-panel {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
}

.feature-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  background: #f0fbf5;
  font-size: 52rpx;
}

.feature-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.feature-title {
  color: #111111;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
}

.feature-desc {
  margin-top: 10rpx;
  color: #7a7a7a;
  font-size: 26rpx;
  line-height: 1.5;
}

.test-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx;
  margin-bottom: 24rpx;
}

.test-copy {
  display: flex;
  flex-direction: column;
}

.test-title {
  color: #222222;
  font-size: 28rpx;
  font-weight: 500;
}

.test-desc {
  margin-top: 6rpx;
  color: #999999;
  font-size: 23rpx;
}

.upload-card {
  overflow: hidden;
  min-height: 720rpx;
}

.poster-image {
  display: block;
  width: 100%;
  height: 720rpx;
  background: #f0f0f0;
}

.upload-placeholder,
.status-panel {
  display: flex;
  min-height: 720rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  text-align: center;
}

.status-panel.standalone,
.error-card.standalone {
  min-height: 320rpx;
  margin-top: 120rpx;
}

.upload-icon {
  margin-bottom: 24rpx;
  font-size: 88rpx;
}

.upload-title,
.status-title {
  color: #222222;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.upload-tip,
.status-desc {
  margin-top: 14rpx;
  color: #999999;
  font-size: 25rpx;
  line-height: 1.5;
}

.loading-spinner {
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 24rpx;
  border: 6rpx solid #eeeeee;
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.error-card {
  padding: 30rpx;
  margin-top: 24rpx;
  text-align: center;
}

.error-text {
  display: block;
  color: #e64340;
  font-size: 27rpx;
  line-height: 1.5;
}

.action-area {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.primary-button,
.secondary-button {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 29rpx;
  line-height: 88rpx;
}

.primary-button {
  background: #07c160;
  color: #ffffff;
}

.secondary-button {
  background: #ffffff;
  color: #07c160;
  border: 2rpx solid #07c160;
}

button::after {
  border: none;
}
