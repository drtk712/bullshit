page {
  background: #f3fcf2;
}

.feature-page {
  min-height: 100vh;
  padding: 0 var(--ui-page-x) 220rpx;
  box-sizing: border-box;
  background: #f3fcf2;
  color: var(--ui-text);
}

.detail-content {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.detail-head {
  margin-top: 16rpx;
  text-align: center;
}

.detail-kicker,
.detail-title,
.tag,
.section-title,
.analysis-title,
.analysis-desc,
.cost-label,
.cost-value,
.state-title,
.state-desc {
  display: block;
}

.detail-kicker {
  color: var(--ui-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 64rpx;
  letter-spacing: 0;
}

.detail-title {
  max-width: 560rpx;
  margin: 16rpx auto 0;
  color: var(--ui-text-soft);
  font-size: 28rpx;
  line-height: 40rpx;
}

.tag-row {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.tag {
  height: 44rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(0, 109, 64, 0.18);
  border-radius: 999rpx;
  background: rgba(0, 109, 64, 0.08);
  color: var(--ui-primary-dark);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.example-card,
.require-card {
  padding: 32rpx;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
  box-sizing: border-box;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-icon {
  color: var(--ui-primary-dark);
  font-size: 34rpx;
  line-height: 1;
}

.section-title {
  color: var(--ui-text);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.example-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 32rpx;
  align-items: stretch;
}

.example-preview {
  position: relative;
  overflow: hidden;
  height: 420rpx;
  border-radius: 24rpx;
  background: var(--ui-surface-high);
}

.report-image {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  transition: opacity 0.24s ease;
}

.report-image.loaded {
  opacity: 1;
}

.report-fallback {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-primary);
  font-size: 96rpx;
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 42%;
  z-index: 3;
  height: 70rpx;
  background: linear-gradient(180deg, rgba(21, 199, 122, 0), rgba(21, 199, 122, 0.18), rgba(21, 199, 122, 0));
}

.analysis-list {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}

.analysis-card {
  min-height: 112rpx;
  padding: 16rpx;
  display: flex;
  gap: 12rpx;
  border: 1rpx solid rgba(187, 202, 189, 0.5);
  border-radius: 16rpx;
  background: var(--ui-surface);
  box-sizing: border-box;
}

.analysis-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: var(--ui-primary);
}

.analysis-card.yellow .analysis-dot {
  background: var(--ui-accent);
}

.analysis-card.coral .analysis-dot {
  background: #ff8f81;
}

.analysis-title {
  color: var(--ui-text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.analysis-desc {
  margin-top: 4rpx;
  display: -webkit-box;
  overflow: hidden;
  color: var(--ui-text-soft);
  font-size: 22rpx;
  line-height: 32rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.require-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx;
}

.require-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  color: var(--ui-text-soft);
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.require-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-primary-dark);
  text-align: center;
  font-size: 42rpx;
  line-height: 96rpx;
}

.bottom-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  padding: 32rpx var(--ui-page-x) calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(226, 234, 225, 0.7);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(40rpx);
  box-shadow: 0 -8rpx 40rpx rgba(23, 33, 27, 0.04);
  display: flex;
  align-items: center;
  gap: 32rpx;
  box-sizing: border-box;
}

.dock-cost {
  flex: 0 0 160rpx;
}

.cost-label {
  color: var(--ui-text-soft);
  font-size: 24rpx;
  line-height: 34rpx;
}

.cost-value {
  margin-top: 4rpx;
  color: var(--ui-accent);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.start-btn {
  flex: 1;
  height: 88rpx;
  margin: 0;
  padding: 0 40rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--ui-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 88rpx;
  box-shadow: 0 10rpx 26rpx rgba(21, 199, 122, 0.18);
}

.start-btn::after {
  border: 0;
}

.state-panel {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
}

.state-panel .mini-spinner {
  margin-bottom: 24rpx;
}

.state-title {
  color: var(--ui-text);
  font-size: 32rpx;
  font-weight: 800;
}

.state-desc {
  margin-top: 12rpx;
  color: var(--ui-text-soft);
  font-size: 26rpx;
}

.state-desc.error {
  color: var(--ui-error);
}

.state-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 20rpx;
  border-radius: 999rpx;
  background: var(--ui-error-soft);
  color: var(--ui-error);
  text-align: center;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 72rpx;
}
