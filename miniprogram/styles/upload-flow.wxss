page {
  background: #f3fcf2;
}

.upload-page,
.progress-page,
.result-page {
  min-height: 100vh;
  padding: 176rpx var(--ui-page-x) 220rpx;
  box-sizing: border-box;
  background: #f3fcf2;
  color: var(--ui-text);
}

.flow-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  height: 152rpx;
  padding: 76rpx var(--ui-page-x) 12rpx;
  justify-content: space-between;
  box-sizing: border-box;
  background: rgba(243, 252, 242, 0.86);
  backdrop-filter: blur(40rpx);
  box-shadow: var(--ui-shadow);
}

.flow-back,
.flow-spacer,
.flow-grid-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  color: var(--ui-primary-dark);
  font-size: 58rpx;
  line-height: 1;
}

.flow-grid-icon {
  flex-wrap: wrap;
  gap: 6rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.flow-grid-icon view {
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid var(--ui-text-soft);
  border-radius: 2rpx;
  box-sizing: border-box;
}

.flow-title {
  position: static;
  color: var(--ui-text);
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 56rpx;
  letter-spacing: 0;
}

.state-card,
.upload-box,
.tips-card,
.progress-card,
.check-card,
.poster-card,
.reward-card,
.modal-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: var(--ui-shadow);
}

.state-card {
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  text-align: center;
}

.state-card .mini-spinner {
  margin-bottom: 18rpx;
}

.state-text {
  color: #8b8580;
  font-size: 26rpx;
}

.state-text.error {
  color: #d85043;
}

.state-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 109, 90, 0.14);
  color: #ff6d5a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.upload-box {
  position: relative;
  min-height: 670rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx dashed var(--ui-primary-dark);
  border-radius: var(--ui-radius-lg);
  background: var(--ui-surface-low);
  box-shadow: var(--ui-shadow);
}

.camera-bubble {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  background: rgba(21, 199, 122, 0.12);
  color: var(--ui-primary-dark);
  font-size: 64rpx;
}

.upload-title,
.upload-sub,
.tips-title,
.progress-title,
.progress-desc,
.check-title,
.check-sub,
.modal-title,
.modal-desc {
  display: block;
}

.upload-title {
  margin-top: 32rpx;
  color: var(--ui-text);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.upload-sub {
  margin-top: 12rpx;
  color: var(--ui-text-soft);
  font-size: 24rpx;
  line-height: 34rpx;
}

.tips-card {
  margin-top: 48rpx;
  padding: 32rpx;
}

.tips-title {
  color: var(--ui-text);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.tip-item,
.check-row {
  display: flex;
  align-items: center;
}

.tip-item {
  margin-top: 20rpx;
  color: var(--ui-text-soft);
  font-size: 28rpx;
  line-height: 40rpx;
}

.check-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #15c77a;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.tips-heading,
.balance-card,
.balance-left,
.balance-right,
.upload-footnote {
  display: flex;
  align-items: center;
}

.tips-heading {
  gap: 16rpx;
  margin-bottom: 4rpx;
}

.tips-icon {
  color: var(--ui-accent);
  font-size: 32rpx;
  line-height: 1;
}

.balance-card {
  min-height: 112rpx;
  margin-top: 48rpx;
  padding: 32rpx;
  justify-content: space-between;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
  box-sizing: border-box;
}

.balance-left {
  gap: 16rpx;
}

.balance-icon {
  color: var(--ui-accent);
  font-size: 40rpx;
  line-height: 1;
}

.balance-label {
  color: var(--ui-text-soft);
  font-size: 28rpx;
  line-height: 40rpx;
}

.balance-right {
  gap: 12rpx;
}

.cost-number {
  color: var(--ui-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.balance-text {
  color: var(--ui-text-soft);
  font-size: 24rpx;
}

.upload-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  padding: 32rpx var(--ui-page-x) calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(243, 252, 242, 0.92);
  backdrop-filter: blur(40rpx);
  box-shadow: 0 -8rpx 40rpx rgba(23, 33, 27, 0.04);
  box-sizing: border-box;
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 48rpx;
  background: var(--ui-primary-dark);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 96rpx;
  box-shadow: 0 12rpx 26rpx rgba(0, 109, 64, 0.18);
}

.generate-btn::after {
  border: 0;
}

.upload-footnote {
  justify-content: center;
  gap: 8rpx;
  margin-top: 16rpx;
  color: var(--ui-text-soft);
  font-size: 22rpx;
  line-height: 32rpx;
  opacity: 0.78;
}

.lock-icon {
  font-size: 20rpx;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.36);
}

.modal-card {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  padding: 48rpx 34rpx 34rpx;
  border-radius: var(--ui-radius-lg);
  text-align: center;
}

.modal-close {
  position: absolute;
  right: 24rpx;
  top: 18rpx;
  color: #8b8580;
  font-size: 42rpx;
}

.coin-art {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #ffd45d;
  color: #9b7210;
  font-size: 78rpx;
  font-weight: 900;
  line-height: 128rpx;
}

.coin-art.error {
  background: rgba(255, 218, 214, 0.62);
  color: var(--ui-error);
}

.modal-title {
  color: var(--ui-text);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.modal-desc {
  margin-top: 12rpx;
  color: var(--ui-text-soft);
  font-size: 26rpx;
  line-height: 38rpx;
}

.modal-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 32rpx;
}

.modal-btn,
.modal-secondary {
  height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.modal-btn {
  background: var(--ui-primary);
  color: var(--ui-primary-dark);
}

.modal-secondary {
  background: var(--ui-surface-high);
  color: var(--ui-text-soft);
}

.modal-btn::after,
.modal-secondary::after {
  border: 0;
}

.progress-hero {
  min-height: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 16rpx;
  text-align: center;
}

.progress-visual {
  position: relative;
  width: 560rpx;
  height: 560rpx;
  margin-top: 56rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-low);
  box-shadow: 0 8rpx 60rpx rgba(21, 199, 122, 0.15);
}

.ring-track,
.ring-fill {
  position: absolute;
  inset: 0;
  border-radius: 999rpx;
}

.ring-track {
  border: 8rpx solid var(--ui-surface-high);
}

.ring-fill {
  border: 10rpx solid transparent;
  border-top-color: var(--ui-primary);
  border-right-color: var(--ui-primary);
  transition: transform 0.3s ease;
}

.mascot-shell {
  position: absolute;
  inset: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 8rpx solid #ffffff;
  border-radius: 999rpx;
  background: var(--ui-surface-high);
}

.progress-mascot-img {
  width: 100%;
  height: 100%;
  animation: floaty 1.8s ease-in-out infinite;
}

@keyframes floaty {
  50% {
    transform: translateY(-12rpx);
  }
}

.progress-title {
  margin-top: 0;
  color: var(--ui-text);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.progress-desc {
  margin-top: 8rpx;
  color: var(--ui-text-soft);
  font-size: 28rpx;
  line-height: 40rpx;
}

.check-card {
  position: relative;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 48rpx;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
}

.progress-bg {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: rgba(21, 199, 122, 0.05);
}

.check-inner {
  position: relative;
  z-index: 1;
}

.check-row {
  min-height: 54rpx;
  gap: 16rpx;
  border-top: 0;
}

.check-title {
  flex: 1;
  color: var(--ui-text);
  font-size: 28rpx;
  line-height: 40rpx;
}

.check-sub {
  color: var(--ui-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.check-sub.muted {
  color: #b8beb9;
}

.check-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.check-main-title {
  color: var(--ui-text);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.check-percent {
  color: var(--ui-primary);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.progress-bar {
  overflow: hidden;
  height: 24rpx;
  margin: 28rpx 0 24rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-high);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--ui-primary);
  transition: width 0.3s ease;
}

.progress-hint {
  align-self: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: auto;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: var(--ui-surface);
  color: var(--ui-text-soft);
  text-align: center;
  font-size: 24rpx;
  line-height: 34rpx;
}

.hint-strong {
  color: var(--ui-primary-dark);
  font-weight: 800;
}

.check-icon {
  flex: 0 0 auto;
  color: var(--ui-primary);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.check-icon.pending {
  color: var(--ui-accent);
}

.poster-card {
  position: relative;
  overflow: hidden;
  width: 100%;
  margin-top: 32rpx;
  padding: 0;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
}

.poster-frame {
  overflow: hidden;
  min-height: 880rpx;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-surface);
}

.poster-image {
  display: block;
  width: 100%;
  height: 880rpx;
}

.poster-placeholder {
  min-height: 880rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-text-soft);
  font-size: 26rpx;
}

.poster-watermark {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(243, 252, 242, 0.82);
  color: var(--ui-primary-dark);
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: var(--ui-shadow);
}

.reward-card {
  margin-top: 48rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: var(--ui-radius-lg);
  background: var(--ui-card);
  box-shadow: var(--ui-shadow);
}

.reward-left {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.reward-icon {
  flex: 0 0 auto;
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: rgba(246, 165, 18, 0.16);
  color: var(--ui-accent);
  text-align: center;
  font-size: 48rpx;
  line-height: 80rpx;
}

.reward-title,
.reward-sub,
.reward-points {
  display: block;
}

.reward-title {
  color: var(--ui-text);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.reward-sub {
  margin-top: 4rpx;
  color: var(--ui-text-soft);
  font-size: 22rpx;
  line-height: 32rpx;
}

.reward-points {
  flex: 0 0 auto;
  color: var(--ui-accent);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.result-tabs {
  display: flex;
  width: 480rpx;
  height: 72rpx;
  margin: 0 auto;
  padding: 8rpx;
  border-radius: 999rpx;
  background: var(--ui-surface-high);
  box-sizing: border-box;
}

.result-tab {
  flex: 1;
  border-radius: 999rpx;
  color: var(--ui-text-soft);
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.result-tab.active {
  background: var(--ui-card);
  color: var(--ui-primary-dark);
  box-shadow: 0 4rpx 16rpx rgba(23, 33, 27, 0.08);
}

.result-tab.active::after {
  display: none;
}

.result-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx var(--ui-page-x) calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(226, 234, 225, 0.7);
  background: rgba(243, 252, 242, 0.92);
  backdrop-filter: blur(40rpx);
  box-shadow: 0 -8rpx 40rpx rgba(23, 33, 27, 0.04);
  box-sizing: border-box;
}

.save-btn,
.share-btn {
  flex: 1;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
  box-sizing: border-box;
}

.save-btn::after,
.share-btn::after {
  border: 0;
}

.save-btn {
  background: var(--ui-surface-high);
  color: var(--ui-text-soft);
}

.share-btn {
  background: var(--ui-primary);
  color: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(21, 199, 122, 0.18);
}
