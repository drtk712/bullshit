page {
  background:
    radial-gradient(circle at 85% 8%, rgba(255, 232, 179, 0.76), transparent 28%),
    radial-gradient(circle at 8% 0%, rgba(199, 255, 229, 0.9), transparent 34%),
    #f7fbf3;
}

.upload-page,
.progress-page,
.result-page {
  min-height: 100vh;
  padding: 92rpx 28rpx 60rpx;
}

.flow-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  height: 86rpx;
  padding: 26rpx 28rpx 0;
  background: rgba(247, 251, 243, 0.82);
  backdrop-filter: blur(20rpx);
}

.flow-back,
.flow-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  color: #111111;
  font-size: 44rpx;
  line-height: 1;
}

.flow-more {
  margin-left: auto;
  font-size: 30rpx;
  font-weight: 900;
}

.result-nav-tools {
  display: flex;
  gap: 18rpx;
  margin-left: auto;
}

.home-tool {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  background: transparent;
  color: #111111;
  font-size: 31rpx;
  line-height: 48rpx;
}

.share-mini {
  font-size: 29rpx;
}

.flow-title {
  position: absolute;
  left: 150rpx;
  right: 150rpx;
  bottom: 11rpx;
  color: #1f2521;
  text-align: center;
  font-size: 25rpx;
  font-weight: 800;
}

.state-card,
.upload-box,
.tips-card,
.cost-card,
.progress-card,
.check-card,
.poster-card,
.reward-card,
.modal-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(39, 32, 24, 0.08);
}

.state-card {
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  text-align: center;
}

.state-card .mini-spinner {
  margin-bottom: 18rpx;
}

.state-text {
  color: #8b8580;
  font-size: 26rpx;
}

.state-text.error {
  color: #d85043;
}

.state-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 109, 90, 0.14);
  color: #ff6d5a;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.upload-box {
  position: relative;
  min-height: 388rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed rgba(21, 199, 122, 0.55);
  background:
    radial-gradient(circle at 80% 82%, rgba(255, 212, 93, 0.2), transparent 22%),
    linear-gradient(135deg, rgba(21, 199, 122, 0.13), rgba(255, 255, 255, 0.85)),
    #ffffff;
}

.camera-bubble {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 144rpx;
  height: 144rpx;
  border-radius: 999rpx;
  background: rgba(21, 199, 122, 0.16);
  font-size: 72rpx;
}

.upload-title,
.upload-sub,
.tips-title,
.cost-label,
.cost-sub,
.progress-title,
.progress-desc,
.check-title,
.check-sub,
.poster-title,
.poster-date,
.reward-text,
.modal-title,
.modal-desc {
  display: block;
}

.upload-title {
  margin-top: 28rpx;
  color: #171615;
  font-size: 34rpx;
  font-weight: 900;
}

.upload-sub {
  margin-top: 12rpx;
  color: #8b8580;
  font-size: 24rpx;
}

.camera-sticker {
  position: absolute;
  right: 54rpx;
  bottom: 28rpx;
  width: 88rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  text-align: center;
  font-size: 52rpx;
  line-height: 72rpx;
  transform: rotate(-8deg);
}

.tips-card,
.cost-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.tips-title {
  color: #171615;
  font-size: 30rpx;
  font-weight: 900;
}

.tip-item,
.cost-card,
.check-row,
.result-actions {
  display: flex;
  align-items: center;
}

.tip-item {
  margin-top: 22rpx;
  color: #5f5a54;
  font-size: 26rpx;
}

.check-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #15c77a;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.cost-card {
  display: block;
}

.cost-label {
  color: #171615;
  font-size: 28rpx;
  font-weight: 900;
}

.cost-sub {
  margin-top: 8rpx;
  color: #8b8580;
  font-size: 23rpx;
}

.cost-value {
  color: #171615;
  font-size: 25rpx;
  font-weight: 800;
}

.cost-value text {
  color: #f29a12;
  font-size: 40rpx;
}

.cost-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 62rpx;
}

.cost-row.balance {
  border-top: 1rpx solid rgba(23, 22, 21, 0.06);
}

.balance-value {
  color: #343b37;
  font-size: 24rpx;
}

.generate-btn {
  height: 82rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #13c777;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 82rpx;
  box-shadow: 0 12rpx 26rpx rgba(19, 199, 119, 0.28);
}

.upload-footnote {
  margin-top: 22rpx;
  color: #a3aaa5;
  text-align: center;
  font-size: 22rpx;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.36);
}

.modal-card {
  position: relative;
  width: 100%;
  padding: 48rpx 34rpx 34rpx;
  text-align: center;
}

.modal-close {
  position: absolute;
  right: 24rpx;
  top: 18rpx;
  color: #8b8580;
  font-size: 42rpx;
}

.coin-art {
  width: 118rpx;
  height: 118rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #ffd45d;
  color: #9b7210;
  font-size: 78rpx;
  line-height: 118rpx;
}

.modal-title {
  color: #171615;
  font-size: 34rpx;
  font-weight: 900;
}

.modal-desc {
  margin-top: 12rpx;
  color: #8b8580;
  font-size: 25rpx;
}

.modal-btn {
  height: 84rpx;
  margin-top: 30rpx;
  border-radius: 999rpx;
  background: #15c77a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.progress-hero {
  min-height: 500rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 52rpx;
  text-align: center;
}

.progress-mascot-img {
  width: 330rpx;
  height: 336rpx;
  margin-top: 40rpx;
  animation: floaty 1.8s ease-in-out infinite;
}

@keyframes floaty {
  50% {
    transform: translateY(-12rpx);
  }
}

.progress-title {
  margin-top: 0;
  color: #171615;
  font-size: 52rpx;
  font-weight: 900;
}

.progress-desc {
  margin-top: 16rpx;
  color: #8b8580;
  font-size: 26rpx;
}

.check-card {
  padding: 24rpx 24rpx 20rpx;
}

.check-row {
  justify-content: space-between;
  min-height: 58rpx;
  border-top: 1rpx solid rgba(23, 22, 21, 0.05);
}

.check-title {
  color: #5f5a54;
  font-size: 24rpx;
}

.check-sub {
  color: #15c77a;
  font-size: 24rpx;
  font-weight: 900;
}

.check-sub.muted {
  color: #b8beb9;
}

.check-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.check-main-title {
  color: #171615;
  font-size: 26rpx;
  font-weight: 900;
}

.check-percent {
  color: #7d8580;
  font-size: 24rpx;
}

.progress-bar {
  overflow: hidden;
  height: 8rpx;
  margin: 16rpx 0 10rpx;
  border-radius: 999rpx;
  background: rgba(23, 22, 21, 0.08);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #15c77a;
  transition: width 0.3s ease;
}

.progress-hint {
  margin-top: 26rpx;
  padding: 19rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #8b8580;
  text-align: center;
  font-size: 22rpx;
}

.remain-line {
  margin-top: 34rpx;
  color: #7d8580;
  text-align: center;
  font-size: 25rpx;
}

.poster-card {
  overflow: hidden;
  padding: 24rpx;
  border-radius: 30rpx;
}

.poster-frame {
  overflow: hidden;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff2df, #ffd8c9);
  border: 3rpx solid #ff7b42;
}

.poster-image {
  display: block;
  width: 100%;
}

.poster-placeholder {
  min-height: 680rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b8580;
  font-size: 26rpx;
}

.reward-card {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fff2ca, #fff8e8);
  text-align: center;
}

.reward-text {
  color: #9b7210;
  font-size: 27rpx;
  font-weight: 900;
}

.result-actions {
  gap: 16rpx;
  margin-top: 22rpx;
}

.result-tabs {
  display: flex;
  justify-content: center;
  gap: 98rpx;
  margin: 4rpx 0 22rpx;
}

.result-tab {
  position: relative;
  color: #a3aaa5;
  font-size: 25rpx;
  font-weight: 800;
}

.result-tab.active {
  color: #15c77a;
}

.result-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 44rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #15c77a;
  transform: translateX(-50%);
}

.save-btn,
.share-btn {
  flex: 1;
  height: 86rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 86rpx;
}

.save-btn {
  background: #ffffff;
  color: #15c77a;
  border: 2rpx solid rgba(21, 199, 122, 0.4);
}

.share-btn {
  background: #15c77a;
  color: #ffffff;
}
